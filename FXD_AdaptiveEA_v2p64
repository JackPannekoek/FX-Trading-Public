bool HasOpenPositionForSymbol()
{
   for(int i=OrdersTotal()-1; i>=0; i--)
   {
      if(!OrderSelect(i, SELECT_BY_POS, MODE_TRADES)) continue;
      if(OrderSymbol() != Symbol()) continue;
      if(OrderMagicNumber() != MagicNumber) continue;
      if(OrderType() == OP_BUY || OrderType() == OP_SELL)
         return true;
   }
   return false;
}

int DetermineQAForcedDirection()
{
   if(QADirectionMode == 1) return DIR_LONG;
   if(QADirectionMode == 2) return DIR_SHORT;
   if(QADirectionMode == 3)
   {
      if(g_lastLiveIntentDir != DIR_NONE) return g_lastLiveIntentDir;
      if(g_lastProbeIntentDir != DIR_NONE) return g_lastProbeIntentDir;
   }
   if((g_qaBarCounter % 2) == 0) return DIR_LONG;
   return DIR_SHORT;
}

bool PolicyAllowsDirection(int policyId, int dir)
{
   if(dir != DIR_LONG && dir != DIR_SHORT) return false;

   if(policyId == POLICY_LONG_BIAS)
      return (dir == DIR_LONG);

   if(policyId == POLICY_SHORT_BIAS)
      return (dir == DIR_SHORT);

   if(policyId == POLICY_BALANCED)
      return true;

   // NoTrade and CompressionNoTrade should never authorize live/probe direction.
   return false;
}

bool AllowQAForcedTrade(int signalDir)
{
   if(!QAForceTrades) return false;
   if(QABarsBetweenTrades < 1) return false;
   if(QAOnlyWhenNoSignal && signalDir != DIR_NONE) return false;
   if(QAOnlyWhenFlat && HasOpenPositionForSymbol()) return false;
   if(g_currentState == STATE_UNKNOWN && !QAAllowUnknownState) return false;
   if(g_currentState == STATE_TRANSITION && !QAAllowTransitionState) return false;
   if((g_qaBarCounter - g_lastQAForcedCounter) < QABarsBetweenTrades) return false;
   return (DetermineQAForcedDirection() != DIR_NONE);
}

