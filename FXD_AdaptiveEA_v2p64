      DoubleToString(tradeDDImpact,2),
      DoubleToString(g_globalAttributedBalance,2));
   FileClose(h);
}


string DirectionName(int dir)
{
   if(dir > 0) return "Long";
   if(dir < 0) return "Short";
   return "Flat";
}

void UpdateAlgoAttribution(int algoId, double pnl, datetime closeTime)
{
   if(algoId < 0 || algoId >= NUM_CORE_ALGOS) return;
   if(g_algoTrades[algoId] == 0)
   {
      g_algoFirstCloseTime[algoId] = closeTime;
      g_algoEquityCurve[algoId] = 10000.0;
      g_algoPeakEquity[algoId] = 10000.0;
   }
   g_algoTrades[algoId]++;
   if(pnl > 0.0) g_algoWins[algoId]++;
   else if(pnl < 0.0) g_algoLosses[algoId]++;

   double tradeDDImpact = (pnl < 0.0 ? -pnl : 0.0);
   if(tradeDDImpact > g_algoWorstTradeDDImpact[algoId])
      g_algoWorstTradeDDImpact[algoId] = tradeDDImpact;
   g_algoSumLossDDImpact[algoId] += tradeDDImpact;
   g_algoSumDDImpactPerTrade[algoId] += tradeDDImpact;

   g_algoNetPnl[algoId] += pnl;
   g_algoEquityCurve[algoId] += pnl;
   if(g_algoEquityCurve[algoId] > g_algoPeakEquity[algoId])
      g_algoPeakEquity[algoId] = g_algoEquityCurve[algoId];
   double dd = g_algoPeakEquity[algoId] - g_algoEquityCurve[algoId];
   if(dd > g_algoMaxDD[algoId]) g_algoMaxDD[algoId] = dd;
   g_algoLastCloseTime[algoId] = closeTime;
}

