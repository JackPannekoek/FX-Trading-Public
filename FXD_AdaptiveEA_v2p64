void OnTick()
{
   UpdateLiveOutcomeAdaptation();
   if(NewBarOnly == 1)
   {
      if(!IsNewBar())
      {
         ManageLiveTrades();
         return;
      }
   }

   UpdateVirtualTrades();
   UpdateSidelinedShadowProbes();
   ManageLiveTrades();
   g_qaBarCounter++;

   FeatureVector fv = BuildFeatureVector();
   g_lastFeatures.atrPips = fv.atrPips;
   g_lastFeatures.atrRatio = fv.atrRatio;
   g_lastFeatures.overlap = fv.overlap;
   g_lastFeatures.pathEff24 = fv.pathEff24;
   g_lastFeatures.pathEff72 = fv.pathEff72;
   g_lastFeatures.breakAsym = fv.breakAsym;
   g_lastFeatures.followAsym = fv.followAsym;
   StateDecision d = ClassifyState(fv);
   g_changeScore = ComputeAdaptiveChangeScore(fv);
   if(g_changeScore > 0.74 && d.stateId != STATE_UNKNOWN)
   {
      d.stateId = STATE_TRANSITION;
      d.isUnknown = false;
      d.isTransition = true;
      d.confidence = Clamp01(d.confidence * 0.86);
   }
   UpdateStateMachine(d);
   g_lastDecision = d;
   g_structureStability = ComputeStructureStability(d);

   int chosenPolicy = SelectPolicyForState();

   double liveLongScore = 0.0, liveShortScore = 0.0;
   double probeLongScore = 0.0, probeShortScore = 0.0;

   ResetSidelinedRelevanceCandidates();
   int liveSignalDir = DecideIntentDirectionAtBar(1, chosenPolicy, false, liveLongScore, liveShortScore);
   FinalizeSidelinedRelevance(fv);

   g_lastLiveLongIntent = liveLongScore;
   g_lastLiveShortIntent = liveShortScore;
   g_lastLiveIntentDir = liveSignalDir;

   double bestProbeStrength = -1.0;
   int probeSignalDir = DIR_NONE;

   // Update virtual probes through policy-specific intent formation, even when live trading is suppressed.
   if(UseVirtualProbeLayer)
   {
      for(int p=0; p<=4; p++)
      {
         bool enabled = false;
         if(p == POLICY_NOTRADE && EnablePolicy_NoTrade) enabled = true;
         if(p == POLICY_BALANCED && EnablePolicy_BalancedBreakout) enabled = true;
         if(p == POLICY_LONG_BIAS && EnablePolicy_LongBiasBreakout) enabled = true;
         if(p == POLICY_SHORT_BIAS && EnablePolicy_ShortBiasBreakout) enabled = true;
         if(p == POLICY_COMPRESSION_NOTRADE && EnablePolicy_CompressionNoTrade) enabled = true;
         if(!enabled) continue;

         double pLong = 0.0, pShort = 0.0;
         int pDir = DecideIntentDirectionAtBar(1, p, true, pLong, pShort);
         double pStrength = MathMax(pLong, pShort);

         if(p == chosenPolicy)
         {
            probeLongScore = pLong;
            probeShortScore = pShort;
            probeSignalDir = pDir;
         }

         if(pDir != DIR_NONE && PolicyAllowsDirection(p, pDir))
            AddVirtualTrade(p, pDir);

         if(pStrength > bestProbeStrength)
         {
            bestProbeStrength = pStrength;
            if(probeSignalDir == DIR_NONE)
            {
               probeSignalDir = pDir;
               probeLongScore = pLong;
               probeShortScore = pShort;
            }
         }
      }
   }

   g_lastProbeLongIntent = probeLongScore;
   g_lastProbeShortIntent = probeShortScore;
   g_lastProbeIntentDir = probeSignalDir;

   g_lastQAEligible = false;
   g_lastQAExecuted = false;
   g_lastQADirection = DIR_NONE;

   if(liveSignalDir != DIR_NONE && PolicyAllowsDirection(chosenPolicy, liveSignalDir))
      OpenLiveTrade(liveSignalDir, g_currentState, chosenPolicy);
   else
   {
      g_lastQAEligible = AllowQAForcedTrade(liveSignalDir);
      if(g_lastQAEligible)
      {
         int qaDir = DetermineQAForcedDirection();
         g_lastQADirection = qaDir;
         g_lastQAExecuted = OpenLiveTrade(qaDir, g_currentState, chosenPolicy);
         if(g_lastQAExecuted)
         {
            g_lastQAForcedCounter = g_qaBarCounter;
            Print("QA forced trade executed dir=", qaDir, " barCounter=", g_qaBarCounter, " state=", StateName(g_currentState));
         }
         else
         {
            Print("QA forced trade attempted but not executed dir=", qaDir, " barCounter=", g_qaBarCounter, " state=", StateName(g_currentState));
         }
      }
   }

   WriteStateSnapshot(fv, d, chosenPolicy);
}
