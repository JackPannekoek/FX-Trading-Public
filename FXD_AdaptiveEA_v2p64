double AlgoAttributedCAGR(int algoId)
{
   if(algoId < 0 || algoId >= 5) return 0.0;
   double startEquity = 10000.0;
   double endEquity = startEquity + g_algoNetPnl[algoId];
   if(endEquity <= 0.0) return -1.0;
   if(g_algoFirstCloseTime[algoId] <= 0 || g_algoLastCloseTime[algoId] <= g_algoFirstCloseTime[algoId]) return 0.0;
   double years = (double)(g_algoLastCloseTime[algoId] - g_algoFirstCloseTime[algoId]) / (365.25 * 24.0 * 60.0 * 60.0);
   if(years <= 0.0) return 0.0;
   return MathPow(endEquity / startEquity, 1.0 / years) - 1.0;
}


