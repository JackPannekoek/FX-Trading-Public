//------------------------------
// v2p56 Behavior Descriptor v2
//------------------------------
// The classifier answers "what is the market doing?" from candle statistics.
// The router answers "which specialist is appropriate for that description?"
// Trade outcomes may still be logged for later research, but are deliberately
// excluded from RouterBehaviorConfidence() and RouterEligible() so current
// behavior recognition cannot chase recent winners.

double DescriptorPath(FeatureVector &f)
{
   return Clamp01(0.58 * Clamp01((f.pathEff24 + 0.02) / 0.34) +
                  0.42 * Clamp01((f.pathEff72 + 0.02) / 0.28));
}

double DescriptorDirectionalAgreement(int dir, FeatureVector &f)
{
   double signedBreak = (dir == DIR_LONG ? f.breakAsym : -f.breakAsym);
   double signedFollow = (dir == DIR_LONG ? f.followAsym : -f.followAsym);
   double agreement = 1.0 - Clamp01(AbsD(signedBreak - signedFollow) / 0.42);
   double direction = 0.55 * Clamp01((signedBreak + 0.08) / 0.38) +
                      0.45 * Clamp01((signedFollow + 0.06) / 0.28);
   return Clamp01(0.55 * agreement + 0.45 * direction);
}

double DescriptorExpansion(FeatureVector &f)
{
   double atr = Clamp01((f.atrRatio - 0.78) / 0.62);
   double lowOverlap = Clamp01((0.68 - f.overlap) / 0.52);
   return Clamp01(0.58 * atr + 0.24 * DescriptorPath(f) + 0.18 * lowOverlap);
}

double DescriptorCompression(FeatureVector &f)
{
   double atr = Clamp01((1.04 - f.atrRatio) / 0.54);
   double overlap = Clamp01((f.overlap - 0.18) / 0.50);
   double lowPath = 1.0 - DescriptorPath(f);
   return Clamp01(0.48 * atr + 0.30 * overlap + 0.22 * lowPath);
}

double DescriptorNoise(FeatureVector &f)
{
   double overlap = Clamp01((f.overlap - 0.24) / 0.48);
   double pathNoise = 1.0 - DescriptorPath(f);
   double disagreement = Clamp01(AbsD(f.breakAsym - f.followAsym) / 0.46);
   return Clamp01(0.44 * overlap + 0.34 * pathNoise + 0.22 * disagreement);
}

double DescriptorPersistence(int dir, FeatureVector &f)
{
   return Clamp01(0.52 * DescriptorPath(f) +
                  0.48 * DescriptorDirectionalAgreement(dir, f));
}

double DescriptorStability(FeatureVector &f)
{
   double structural = Clamp01(0.48 * DescriptorPath(f) +
                               0.28 * (1.0 - DescriptorNoise(f)) +
                               0.24 * Clamp01((1.35 - AbsD(f.atrRatio - 1.0)) / 1.35));
   structural -= 0.34 * g_changeScore;
   return Clamp01(structural);
}

string RouterConfidenceClass(double c)
{
   if(c >= 0.50) return "HIGH";
   if(c >= 0.32) return "MEDIUM";
   return "LOW";
}

double RouterBehaviorConfidence(int stateId, int dir, FeatureVector &f)
{
   double classConfidence = g_lastDecision.confidence;
   double persistence = DescriptorPersistence(dir, f);
   double stability = DescriptorStability(f);
   double noise = DescriptorNoise(f);
   double expansion = DescriptorExpansion(f);
   double compression = DescriptorCompression(f);

   // v2p57: confidence measures whether the descriptor vector itself forms a
   // distinctive, coherent market description. Separation raises confidence;
   // change/instability lowers it. This remains entirely candle-statistic based.
   double hi = MathMax(MathMax(persistence, expansion), MathMax(compression, 1.0-noise));
   double lo = MathMin(MathMin(persistence, expansion), MathMin(compression, 1.0-noise));
   double separation = Clamp01((hi - lo) / 0.62);
   double coherence = 0.26 * stability +
                      0.22 * (1.0 - noise) +
                      0.18 * MathMax(expansion, compression) +
                      0.16 * persistence +
                      0.12 * separation +
                      0.06 * classConfidence;

   if(stateId == STATE_TRANSITION)
      coherence = 0.88 * coherence + 0.12 * TransitionTradability();
   else if(stateId == STATE_UNKNOWN)
      coherence *= 0.80;

   coherence -= 0.16 * g_changeScore;
   if(stability > 0.56 && separation > 0.34) coherence += 0.06;
   if(stability < 0.24 && noise > 0.58) coherence -= 0.08;
   return Clamp01(coherence);
}

double RouterDescriptorFit(int algoId, int stateId, int dir, FeatureVector &f)
{
   double persistence = DescriptorPersistence(dir, f);
   double expansion = DescriptorExpansion(f);
   double compression = DescriptorCompression(f);
   double noise = DescriptorNoise(f);
   double stability = DescriptorStability(f);
   double signedBreak = (dir == DIR_LONG ? f.breakAsym : -f.breakAsym);
   double signedFollow = (dir == DIR_LONG ? f.followAsym : -f.followAsym);
   double directional = Clamp01(0.55 * Clamp01((signedBreak + 0.08) / 0.38) +
                                0.45 * Clamp01((signedFollow + 0.06) / 0.28));
   double moderatePersistence = 1.0 - Clamp01(AbsD(persistence - 0.52) / 0.48);
   double moderateExpansion = 1.0 - Clamp01(AbsD(expansion - 0.58) / 0.42);
   double releaseTension = Clamp01(0.52 * compression +
                                   0.30 * Clamp01((f.atrRatio - 0.82) / 0.46) +
                                   0.18 * directional);
   double fit = 0.0;

   if(algoId == CORE_BREAKOUT) // TrendRetest: orderly expansion/shock retest specialist
      fit = 0.34 * expansion + 0.24 * stability + 0.16 * moderatePersistence +
            0.14 * directional + 0.12 * (1.0 - compression);
   else if(algoId == CORE_PULLBACK) // moderate movement, stable structure, not raw directional chase
      fit = 0.28 * moderateExpansion + 0.24 * stability + 0.20 * moderatePersistence +
            0.16 * directional + 0.12 * (1.0 - noise);
   else if(algoId == CORE_COMPRESSION_RELEASE) // compression-to-release / transition specialist
      fit = 0.34 * releaseTension + 0.24 * compression + 0.16 * directional +
            0.14 * (1.0 - stability) + 0.12 * (1.0 - noise);
   else if(algoId == CORE_SHORT_HOLD) // sidelined: opportunistic short-lived disorder/shock niche
      fit = 0.30 * noise + 0.22 * (1.0 - stability) + 0.18 * moderateExpansion +
            0.16 * compression + 0.14 * directional;
   else if(algoId == CORE_DRIFT_CONTINUATION) // RangeReclaim: overlapped/noisy but controlled structure
      fit = 0.28 * noise + 0.24 * stability + 0.20 * (1.0 - persistence) +
            0.16 * Clamp01((f.overlap - 0.20) / 0.48) + 0.12 * (1.0 - expansion);
   else if(algoId == CORE_DELAYED_CONFIRMATION) // sidelined; continue shadow relevance/profitability evaluation
      fit = 0.28 * stability + 0.22 * moderatePersistence + 0.20 * moderateExpansion +
            0.16 * directional + 0.14 * (1.0 - noise);
   else if(algoId == CORE_MOMENTUM_CONTINUATION) // v2p63 pass 2: clean short-directional persistence specialist
   {
      double cleanTrend = 0.38 * persistence + 0.28 * stability + 0.22 * directional +
                          0.12 * (1.0 - noise);
      fit = 0.72 * cleanTrend + 0.18 * moderateExpansion + 0.10 * (1.0 - compression);
      if(dir == DIR_SHORT) fit += 0.06;
   }
   else if(algoId == CORE_EXHAUSTION_RESET) // v2p63 pass 2: late-directional / shock exhaustion specialist
   {
      double exhaustion = Clamp01(0.38 * expansion + 0.20 * noise +
                                  0.18 * (1.0 - stability) + 0.14 * (1.0 - persistence) +
                                  0.10 * Clamp01(g_changeScore));
      double fadingCoherence = Clamp01(0.44 * (1.0 - directional) +
                                       0.30 * (1.0 - persistence) +
                                       0.26 * noise);
      fit = 0.58 * exhaustion + 0.26 * fadingCoherence + 0.16 * moderateExpansion;
   }
   else if(algoId == CORE_LONG_STRUCTURE_CONTINUATION) // v2p64 new: clean long structural continuation specialist
   {
      double cleanTrend = Clamp01(0.36 * persistence + 0.28 * stability +
                                  0.22 * directional + 0.14 * (1.0 - noise));
      double orderlyExpansion = Clamp01(0.46 * moderateExpansion +
                                        0.34 * expansion +
                                        0.20 * (1.0 - compression));
      fit = 0.62 * cleanTrend + 0.28 * orderlyExpansion + 0.10 * directional;
      if(dir == DIR_LONG) fit += 0.07;
      else fit -= 0.10;
   }
   else
      fit = 0.0;

   // State labels are now weak interpretive priors only; descriptor geometry
   // should determine the specialist rather than a category name.
   if(stateId == STATE_KNOWN_3 && algoId == CORE_BREAKOUT) fit += 0.03;
   if(stateId == STATE_TRANSITION && algoId == CORE_COMPRESSION_RELEASE) fit += 0.03;
   if(stateId == STATE_TRANSITION && algoId == CORE_PULLBACK) fit += 0.02;
   if(stateId == STATE_KNOWN_0 && algoId == CORE_DRIFT_CONTINUATION) fit += 0.02;
   if(stateId == STATE_KNOWN_2 && algoId == CORE_MOMENTUM_CONTINUATION) fit += 0.06;
   if((stateId == STATE_TRANSITION || stateId == STATE_KNOWN_3) && algoId == CORE_MOMENTUM_CONTINUATION) fit -= 0.05;
   if((stateId == STATE_KNOWN_3 || stateId == STATE_KNOWN_4) && algoId == CORE_EXHAUSTION_RESET) fit += 0.05;
   if(stateId == STATE_TRANSITION && algoId == CORE_EXHAUSTION_RESET) fit -= 0.08;
   if(stateId == STATE_KNOWN_4 && algoId == CORE_LONG_STRUCTURE_CONTINUATION) fit += 0.07;
   if((stateId == STATE_TRANSITION || stateId == STATE_KNOWN_3 || stateId == STATE_KNOWN_1) && algoId == CORE_LONG_STRUCTURE_CONTINUATION) fit -= 0.06;
   if(stateId == STATE_UNKNOWN) fit -= 0.04;

   return Clamp01(fit);
}

bool RouterEligible(int algoId, int stateId, int dir, double routerConfidence, FeatureVector &f)
{
   if(CoreAlgoIsSidelined(algoId)) return false;

   double fit = RouterDescriptorFit(algoId, stateId, dir, f);
   double requiredFit = 0.55;
   if(routerConfidence >= 0.50) requiredFit = 0.44;
   else if(routerConfidence >= 0.32) requiredFit = 0.54;
   else requiredFit = 0.66;

   // Do not force a specialist during weak or unstable descriptions.
   if(DescriptorStability(f) < 0.24 && routerConfidence < 0.50) requiredFit += 0.06;
   if(stateId == STATE_UNKNOWN) requiredFit += 0.04;
   if(stateId == STATE_TRANSITION && TransitionTradability() < 0.44) requiredFit += 0.04;

   // v2p62 specialist enforcement. Pullback is sidelined above and cannot reach this point.
   // TrendRetest is now restricted toward the repeatedly positive expansion/shock niche.
   if(algoId == CORE_BREAKOUT)
   {
      if(DescriptorExpansion(f) < 0.56) return false;
      if(stateId == STATE_TRANSITION && routerConfidence < 0.50) return false;
      requiredFit += 0.03;
   }
   // v2p63: RangeReclaim is a non-established-direction specialist. Repeated tests
   // show its useful contribution in Transition/Balanced/Shock and persistent losses
   // in established long/short directional states.
   if(algoId == CORE_DRIFT_CONTINUATION)
   {
      if(stateId == STATE_KNOWN_2 || stateId == STATE_KNOWN_4) return false;
      if(stateId == STATE_TRANSITION && (routerConfidence < 0.50 || DescriptorExpansion(f) < 0.52)) return false;
      if(DescriptorPersistence(dir,f) > 0.70 && DescriptorNoise(f) < 0.34) return false;
      requiredFit += 0.02;
   }
   if(algoId == CORE_MOMENTUM_CONTINUATION)
   {
      // Pass 2: only clean SHORT continuation. This is intentionally narrow so we can
      // validate the positive ShortBiasDirectional pocket before broadening again.
      if(dir != DIR_SHORT) return false;
      if(routerConfidence < 0.32) return false;
      if(stateId == STATE_TRANSITION || stateId == STATE_KNOWN_3 || stateId == STATE_KNOWN_1) return false;
      if(DescriptorPersistence(dir,f) < 0.62) return false;
      if(DescriptorStability(f) < 0.46) return false;
      if(DescriptorNoise(f) > 0.46) return false;
      requiredFit += 0.04;
   }
   if(algoId == CORE_EXHAUSTION_RESET)
   {
      // Pass 2: Transition was the first-pass failure pocket. Require a genuine
      // expansion/exhaustion context and focus on late-directional or shock structure.
      if(stateId == STATE_TRANSITION || stateId == STATE_KNOWN_1) return false;
      if(DescriptorExpansion(f) < 0.58) return false;
      if(DescriptorPersistence(dir,f) > 0.78) return false;
      if(DescriptorNoise(f) < 0.24 && g_changeScore < 0.34) return false;
      if(stateId != STATE_KNOWN_3 && stateId != STATE_KNOWN_4 && routerConfidence < 0.50) return false;
      requiredFit += 0.04;
   }
   if(algoId == CORE_LONG_STRUCTURE_CONTINUATION)
   {
      // v2p64 probation pass 1: cover the clean LONG directional gap without
      // duplicating MomentumContinuation's validated short-only specialty.
      if(dir != DIR_LONG) return false;
      if(routerConfidence < 0.32) return false;
      if(stateId == STATE_TRANSITION || stateId == STATE_KNOWN_3 || stateId == STATE_KNOWN_1) return false;
      if(stateId != STATE_KNOWN_4 && routerConfidence < 0.50) return false;
      if(DescriptorPersistence(dir,f) < 0.60) return false;
      if(DescriptorStability(f) < 0.48) return false;
      if(DescriptorNoise(f) > 0.44) return false;
      if(DescriptorExpansion(f) < 0.36) return false;
      requiredFit += 0.04;
   }

   return (fit >= requiredFit);
}

double RouterFitBias(int algoId, int stateId, int dir, FeatureVector &f, double routerConfidence)
{
   double fit = RouterDescriptorFit(algoId, stateId, dir, f);
   // Fit contributes materially to ranking, while confidence controls how much
   // authority that fit has. No trade-result feedback is used here.
   return (fit - 0.50) * (0.26 + 0.30 * routerConfidence);
}

void ResetSidelinedRelevanceCandidates()
{
   for(int a=0; a<NUM_CORE_ALGOS; a++)
   {
      g_relevanceCandidateStrength[a] = 0.0;
      g_relevanceCandidateDir[a] = DIR_NONE;
   }
}

void ConsiderSidelinedRelevanceCandidate(int algoId, int stateId, int dir, double rawScore,
                                         double routerConfidence, FeatureVector &f)
{
   if(algoId < 0 || algoId >= NUM_CORE_ALGOS) return;
   if(!CoreAlgoIsSidelined(algoId)) return;
   if(dir != DIR_LONG && dir != DIR_SHORT) return;

   double fit = RouterDescriptorFit(algoId, stateId, dir, f);
   double strength = Clamp01(0.72 * fit + 0.13 * rawScore + 0.15 * routerConfidence);
   if(strength > g_relevanceCandidateStrength[algoId])
   {
      g_relevanceCandidateStrength[algoId] = strength;
      g_relevanceCandidateDir[algoId] = dir;
   }
}

void UpdateSidelinedShadowProbes()
{
   double exitPrice = iClose(Symbol(), Period(), 1);
   if(exitPrice <= 0.0) return;

   for(int a=0; a<NUM_CORE_ALGOS; a++)
   {
      if(!g_sidelinedShadow[a].active) continue;
      g_sidelinedShadow[a].barsHeld++;
      if(g_sidelinedShadow[a].barsHeld < 6) continue;

      double atr = g_sidelinedShadow[a].atrAtEntry;
      if(atr <= 0.0) atr = GetATR(1);
      if(atr <= 0.0) atr = PipSize() * 10.0;
      double move = (exitPrice - g_sidelinedShadow[a].entryPrice);
      if(g_sidelinedShadow[a].dir == DIR_SHORT) move = -move;
      double outcomeR = move / (1.5 * atr);
      if(outcomeR > 2.0) outcomeR = 2.0;
      if(outcomeR < -2.0) outcomeR = -2.0;

      g_shadowTrades[a]++;
      if(outcomeR > 0.0) g_shadowWins[a]++;
      g_shadowNetR[a] += outcomeR;
      g_relevancePerfEmaR[a] = 0.88 * g_relevancePerfEmaR[a] + 0.12 * outcomeR;
      g_sidelinedShadow[a].active = false;
   }
}

void FinalizeSidelinedRelevance(FeatureVector &f)
{
   double entryPrice = iOpen(Symbol(), Period(), 0);
   if(entryPrice <= 0.0) entryPrice = iClose(Symbol(), Period(), 1);
   double atr = GetATR(1);

   for(int a=0; a<NUM_CORE_ALGOS; a++)
   {
      // Relevance is maintained for every algorithm so status changes retain history,
      // but only sidelined algorithms consume shadow-probe resources.
      double currentFit = g_relevanceCandidateStrength[a];
      if(!CoreAlgoIsSidelined(a))
      {
         double lf = RouterDescriptorFit(a, g_currentState, DIR_LONG, f);
         double sf = RouterDescriptorFit(a, g_currentState, DIR_SHORT, f);
         currentFit = MathMax(lf, sf);
      }
      g_relevanceDescriptorEma[a] = 0.94 * g_relevanceDescriptorEma[a] + 0.06 * currentFit;

      double perfScore = Clamp01(0.50 + 0.25 * g_relevancePerfEmaR[a]);
      g_relevanceFactor[a] = Clamp01(0.68 * g_relevanceDescriptorEma[a] + 0.32 * perfScore);

      if(CoreAlgoIsSidelined(a))
      {
         g_relevanceObservedBars[a]++;
         if(g_relevanceFactor[a] >= 0.55) g_relevanceHighBars[a]++;
      }

      if(!CoreAlgoIsSidelined(a)) continue;
      if(g_sidelinedShadow[a].active) continue;
      if(g_relevanceCandidateDir[a] == DIR_NONE) continue;
      if(g_relevanceCandidateStrength[a] < 0.60) continue;
      if(atr <= 0.0 || entryPrice <= 0.0) continue;

      g_sidelinedShadow[a].active = true;
      g_sidelinedShadow[a].algoId = a;
      g_sidelinedShadow[a].dir = g_relevanceCandidateDir[a];
      g_sidelinedShadow[a].entryPrice = entryPrice;
      g_sidelinedShadow[a].atrAtEntry = atr;
      g_sidelinedShadow[a].barsHeld = 0;
      g_sidelinedShadow[a].triggerStrength = g_relevanceCandidateStrength[a];
   }
}

int SidelinedReactivationRank(int algoId)
{
   if(!CoreAlgoIsSidelined(algoId)) return 0;
   int rank = 1;
   for(int a=0; a<NUM_CORE_ALGOS; a++)
      if(CoreAlgoIsSidelined(a) && g_relevanceFactor[a] > g_relevanceFactor[algoId]) rank++;
   return rank;
}

// PF discovery governance carried into v2p61:
// Overall PF below 1.10 normally triggers new sub-EA discovery. A sidelined algorithm
// with sufficient Profitability Promise/Replacement Readiness gets first right of
// reactivation. v2p61 is that one-pass Pullback reactivation test.
// v2p59: Estimate dormant profitability separately from current-market relevance.
// Sparse shadow results are shrunk toward neutral until enough samples accumulate,
// preventing a tiny lucky sample from automatically becoming the top replacement.
double SidelinedReactivationCooldownPenalty(int algoId)
{
   if(algoId < 0 || algoId >= NUM_CORE_ALGOS) return 0.0;
   if(!CoreAlgoIsSidelined(algoId)) return 0.0;

   // v2p63: hard-coded recent live failures become a decaying history penalty.
   // The penalty fades as new shadow evidence accumulates during the run, preventing
   // permanent blacklisting while stopping immediate recycle/re-entry loops.
   double basePenalty = 0.0;
   if(algoId == CORE_PULLBACK) basePenalty = 0.18;              // failed v2p61 reactivation
   if(algoId == CORE_DELAYED_CONFIRMATION) basePenalty = 0.12; // failed v2p60 reactivation
   if(basePenalty <= 0.0) return 0.0;

   double observed = (double)g_relevanceObservedBars[algoId];
   double decay = MathExp(-observed / 18000.0);
   return basePenalty * decay;
}

double SidelinedProfitabilityPotential(int algoId)
{
   if(algoId < 0 || algoId >= NUM_CORE_ALGOS) return 0.0;
   if(!CoreAlgoIsSidelined(algoId)) return 0.0;

   int n = g_shadowTrades[algoId];
   double avgR = (n > 0 ? g_shadowNetR[algoId] / (double)n : 0.0);
   double winRate = (n > 0 ? (double)g_shadowWins[algoId] / (double)n : 0.50);

   // Confidence rises smoothly with evidence but remains conservative for small samples.
   double sampleConfidence = 1.0 - MathExp(-(double)n / 60.0);
   double expectancyScore = Clamp01(0.50 + 0.40 * avgR);
   double winScore = Clamp01((winRate - 0.35) / 0.30);
   double perfEvidence = 0.68 * expectancyScore + 0.32 * winScore;
   double shrunkPerformance = 0.50 + sampleConfidence * (perfEvidence - 0.50);

   // Relevance says whether the present market resembles the algorithm's niche;
   // shadow evidence says whether hypothetical participation has recently paid.
   double potential = 0.42 * g_relevanceFactor[algoId] +
                      0.48 * shrunkPerformance +
                      0.10 * sampleConfidence;
   potential -= SidelinedReactivationCooldownPenalty(algoId);
   return Clamp01(potential);
}

int SidelinedReplacementRank(int algoId)
{
   if(!CoreAlgoIsSidelined(algoId)) return 0;
   double p = SidelinedProfitabilityPotential(algoId);
   int rank = 1;
   for(int a=0; a<NUM_CORE_ALGOS; a++)
      if(CoreAlgoIsSidelined(a) && SidelinedProfitabilityPotential(a) > p) rank++;
   return rank;
}

// v2p60: Persistence-aware readiness. This is intentionally not used to alter
// live routing inside the current run; it is a roster-management diagnostic.
double SidelinedRelevancePersistence(int algoId)
{
   if(algoId < 0 || algoId >= NUM_CORE_ALGOS) return 0.0;
   if(!CoreAlgoIsSidelined(algoId)) return 0.0;
   int n = g_relevanceObservedBars[algoId];
   if(n <= 0) return 0.0;
   return Clamp01((double)g_relevanceHighBars[algoId] / (double)n);
}

double SidelinedReplacementReadiness(int algoId)
{
   if(algoId < 0 || algoId >= NUM_CORE_ALGOS) return 0.0;
   if(!CoreAlgoIsSidelined(algoId)) return 0.0;

   int n = g_shadowTrades[algoId];
   double sampleConfidence = 1.0 - MathExp(-(double)n / 60.0);
   double potential = SidelinedProfitabilityPotential(algoId);
   double persistence = SidelinedRelevancePersistence(algoId);

   double readiness = 0.45 * potential +
                      0.25 * g_relevanceFactor[algoId] +
                      0.20 * persistence +
                      0.10 * sampleConfidence;
   readiness -= 0.35 * SidelinedReactivationCooldownPenalty(algoId);
   return Clamp01(readiness);
}

int SidelinedReadinessRank(int algoId)
{
   if(!CoreAlgoIsSidelined(algoId)) return 0;
   double r = SidelinedReplacementReadiness(algoId);
   int rank = 1;
   for(int a=0; a<NUM_CORE_ALGOS; a++)
      if(CoreAlgoIsSidelined(a) && SidelinedReplacementReadiness(a) > r) rank++;
   return rank;
}

void ConsiderRouterCandidate(int algoId, double rawScore, bool eligible, int stateId, int dir, FeatureVector &f,
                             double routerConfidence, int &chosenAlgo,
                             double &bestScore, double &secondScore,
                             string &eligibleNames)
{
   if(!eligible) return;
   if(StringLen(eligibleNames) > 0) eligibleNames += "|";
   eligibleNames += CoreAlgoName(algoId);

   double routed = Clamp01(rawScore + RouterFitBias(algoId, stateId, dir, f, routerConfidence));
   if(chosenAlgo < 0 || routed > bestScore)
   {
      secondScore = bestScore;
      bestScore = routed;
      chosenAlgo = algoId;
   }
   else if(routed > secondScore)
      secondScore = routed;
}

double CoreAlgoScore(int algoId,
                     int stateId,
                     int dir,
                     double breakoutStrength,
                     double bodyImpulse,
                     double closeLocationScore,
                     double followNorm,
                     double breakNorm,
                     double pathNorm,
                     double alignment,
                     double structureQuality,
                     double localEdgeSupport,
                     double localEdgePenalty,
                     double stateDirBiasVal,
                     FeatureVector &f)
{
   double score = 0.0;
   if(algoId == CORE_BREAKOUT)
   {
      // v2p54 TrendRetest pass 3: narrow behavior specialty.
      // Require an established directional path and agreement first, then
      // reward a moderate retracement that has not destroyed that structure.
      // This is intentionally different from v2p52's broad low-impulse retest.
      double directionalBase = 0.30 * pathNorm +
                               0.24 * alignment +
                               0.20 * structureQuality +
                               0.16 * followNorm +
                               0.10 * Clamp01((stateDirBiasVal + 0.08) / 0.30);
      double retestDepth = 0.30 * Clamp01((0.34 - breakoutStrength) / 0.28) +
                           0.24 * Clamp01((0.38 - bodyImpulse) / 0.30) +
                           0.18 * Clamp01((f.overlap - 0.10) / 0.34) +
                           0.14 * Clamp01((0.48 - breakNorm) / 0.34) +
                           0.14 * Clamp01((0.82 - closeLocationScore) / 0.48);
      double retestRecovery = 0.42 * followNorm +
                              0.28 * alignment +
                              0.18 * localEdgeSupport +
                              0.12 * Clamp01((0.46 - localEdgePenalty) / 0.46);
      score = 0.50 * directionalBase +
              0.26 * retestDepth +
              0.24 * retestRecovery;
      // v2p54: directional states were the major v2p53 TrendRetest losers.
      // Give pass 3 a materially different niche: orderly retests after balanced
      // expansion / shock, and make the prior directional use unattractive.
      if(stateId == STATE_KNOWN_0) score += 0.04;
      if(stateId == STATE_KNOWN_3) score += 0.06;
      if(stateId == STATE_TRANSITION) score -= 0.08;
      if(stateId == STATE_KNOWN_1) score -= 0.08;
      if(stateId == STATE_KNOWN_2 || stateId == STATE_KNOWN_4) score -= 0.10;
      if(pathNorm < 0.48) score -= 0.16 * Clamp01((0.48 - pathNorm) / 0.32);
      if(alignment < 0.16) score -= 0.14 * Clamp01((0.16 - alignment) / 0.20);
      if(breakoutStrength > 0.40) score -= 0.14 * Clamp01((breakoutStrength - 0.40) / 0.30);
      if(bodyImpulse > 0.44) score -= 0.12 * Clamp01((bodyImpulse - 0.44) / 0.30);
      if(localEdgeSupport < 0.20) score -= 0.10;
      if(stateDirBiasVal < -0.02) score -= 0.12 * Clamp01((-stateDirBiasVal - 0.02) / 0.26);
   }
   else if(algoId == CORE_PULLBACK)
   {
      double pullbackShape = 0.42 * Clamp01((0.24 - breakoutStrength) / 0.24) +
                             0.26 * pathNorm +
                             0.18 * followNorm +
                             0.14 * Clamp01((0.72 - closeLocationScore) / 0.72);
      score = 0.30 * pullbackShape +
              0.26 * Clamp01((stateDirBiasVal + 0.10) / 0.36) +
              0.18 * structureQuality +
              0.22 * localEdgeSupport +
              0.04 * Clamp01((0.64 - f.overlap) / 0.64);
      // v2p54: Pullback was positive in ShortBiasDirectional and materially
      // negative in ShockExpansion in v2p53, so specialize accordingly.
      if(stateId == STATE_KNOWN_2) score -= 0.04;
      if(stateId == STATE_KNOWN_3) score += 0.04;
      if(stateId == STATE_KNOWN_4) score -= 0.04;
      if(stateId == STATE_KNOWN_1) score -= 0.04;
      if(stateId == STATE_KNOWN_0) score -= 0.02;
      if(stateId == STATE_TRANSITION) score += 0.04;
      score -= 0.08;
      if(localEdgeSupport < 0.20) score -= 0.06;
      if(localEdgeSupport > 0.18) score += 0.05 * Clamp01((localEdgeSupport - 0.18) / 0.30);
   }
   else if(algoId == CORE_COMPRESSION_RELEASE)
   {
      // v2p53: controlled return from the sideline. Favor genuine compression
      // followed by coherent release, not merely any low-ATR bar sequence.
      double compressionContext = 0.34 * Clamp01((0.98 - f.atrRatio) / 0.58) +
                                  0.28 * Clamp01((f.overlap - 0.20) / 0.46) +
                                  0.20 * breakoutStrength +
                                  0.18 * followNorm;
      double releaseQuality = 0.30 * alignment +
                              0.24 * breakNorm +
                              0.20 * followNorm +
                              0.16 * localEdgeSupport +
                              0.10 * structureQuality;
      score = 0.46 * compressionContext +
              0.34 * releaseQuality +
              0.12 * localEdgeSupport +
              0.08 * Clamp01((0.50 - localEdgePenalty) / 0.50);
      // v2p54: specialize CompressionRelease where v2p53 attribution was best.
      if(stateId == STATE_KNOWN_2) score -= 0.02;
      if(stateId == STATE_KNOWN_1) score += 0.02;
      if(stateId == STATE_TRANSITION && TransitionTradability() > 0.48) score += 0.08;
      if(stateId == STATE_KNOWN_0) score -= 0.06;
      if(stateId == STATE_KNOWN_3) score -= 0.02;
      if(stateId == STATE_KNOWN_4) score -= 0.05;
      if(f.atrRatio > 1.08) score -= 0.12 * Clamp01((f.atrRatio - 1.08) / 0.35);
      if(f.overlap < 0.18) score -= 0.10;
      if(localEdgeSupport < 0.16) score -= 0.08;
   }
   else if(algoId == CORE_SHORT_HOLD)
   {
      double opportunistic = 0.18 * breakoutStrength +
                             0.14 * bodyImpulse +
                             0.16 * followNorm +
                             0.18 * Clamp01((0.72 - pathNorm) / 0.72) +
                             0.18 * Clamp01((f.overlap - 0.10) / 0.58) +
                             0.16 * Clamp01((0.76 - structureQuality) / 0.76);
      score = 0.34 * opportunistic +
              0.18 * localEdgeSupport +
              0.16 * Clamp01((0.58 - localEdgePenalty) / 0.58) +
              0.08 * alignment +
              0.08 * Clamp01((0.56 - MathAbs(stateDirBiasVal)) / 0.56);
      if(stateId == STATE_KNOWN_3 || stateId == STATE_KNOWN_1) score += 0.04;
      if(stateId == STATE_TRANSITION) score -= 0.06;
      if(stateId == STATE_KNOWN_0 || stateId == STATE_KNOWN_2 || stateId == STATE_KNOWN_4) score -= 0.14;
      if(localEdgeSupport < 0.28) score -= 0.14;
   }
   else if(algoId == CORE_DRIFT_CONTINUATION)
   {
      double rangeReclaim = 0.24 * Clamp01((f.overlap - 0.22) / 0.48) +
                            0.20 * Clamp01((0.62 - pathNorm) / 0.62) +
                            0.16 * Clamp01((0.95 - f.atrRatio) / 0.55) +
                            0.14 * Clamp01((0.22 - breakNorm) / 0.22) +
                            0.12 * Clamp01((0.20 - followNorm) / 0.20) +
                            0.14 * Clamp01((0.70 - structureQuality) / 0.70);
      double reclaimQuality = 0.22 * Clamp01((0.18 - MathAbs(stateDirBiasVal)) / 0.18 + 0.5) +
                              0.18 * Clamp01((0.22 - alignment) / 0.22 + 0.5) +
                              0.16 * Clamp01((0.26 - bodyImpulse) / 0.26) +
                              0.16 * localEdgeSupport +
                              0.12 * Clamp01((0.50 - localEdgePenalty) / 0.50) +
                              0.16 * Clamp01((0.55 - f.atrRatio) / 0.55 + 0.5);
      score = 0.32 * rangeReclaim +
              0.32 * reclaimQuality +
              0.10 * structureQuality +
              0.08 * Clamp01((0.50 - localEdgePenalty) / 0.50) +
              0.08 * Clamp01((0.20 - MathAbs(stateDirBiasVal)) / 0.20 + 0.5);
      // v2p54: v2p53 showed a profitable BalancedExpansion pocket and a large
      // Transition loss. Concentrate RangeReclaim on that measured edge.
      if(stateId == STATE_KNOWN_0) score += 0.06;
      if(stateId == STATE_TRANSITION) score -= 0.06;
      if(stateId == STATE_KNOWN_1) score += 0.02;
      if(stateId == STATE_KNOWN_3) score -= 0.02;
      if(stateId == STATE_KNOWN_2 || stateId == STATE_KNOWN_4) score -= 0.08;
      score += 0.08 * localEdgeSupport;
      if(f.atrRatio > 1.15) score -= 0.08 * Clamp01((f.atrRatio - 1.15) / 0.40);
      if(pathNorm > 0.72) score -= 0.08 * Clamp01((pathNorm - 0.72) / 0.20);
   }
   else if(algoId == CORE_DELAYED_CONFIRMATION)
   {
      double delayedContext = 0.28 * breakoutStrength +
                              0.24 * followNorm +
                              0.20 * pathNorm +
                              0.12 * alignment +
                              0.10 * structureQuality +
                              0.06 * Clamp01((0.50 - f.overlap) / 0.50);
      double lowImmediateNoise = 0.55 * Clamp01((0.22 - bodyImpulse) / 0.22) +
                                 0.45 * Clamp01((0.18 - breakNorm) / 0.18);
      score = 0.32 * delayedContext +
              0.18 * lowImmediateNoise +
              0.22 * localEdgeSupport +
              0.14 * Clamp01((stateDirBiasVal + 0.10) / 0.30) +
              0.08 * Clamp01((0.55 - localEdgePenalty) / 0.55) +
              0.06 * Clamp01((0.35 - f.atrRatio) / 0.35 + 0.5);
      if(stateId == STATE_TRANSITION) score += 0.12;
      if(stateId == STATE_KNOWN_1) score += 0.16;
      if(stateId == STATE_KNOWN_4) score -= 0.04;
      if(stateId == STATE_KNOWN_2) score -= 0.22;
      if(stateId == STATE_KNOWN_3) score -= 0.30;
      score -= 0.08;
      if(localEdgeSupport > 0.14) score += 0.06 * Clamp01((localEdgeSupport - 0.14) / 0.25);
      if(bodyImpulse > 0.20) score -= 0.05 * Clamp01((bodyImpulse - 0.20) / 0.30);
      if(localEdgeSupport < 0.10) score -= 0.02;
   }
   else if(algoId == CORE_MOMENTUM_CONTINUATION)
   {
      // v2p63 pass 2: validate clean short-directional continuation only.
      double persistence = DescriptorPersistence(dir,f);
      double stability = DescriptorStability(f);
      double noise = DescriptorNoise(f);
      double expansion = DescriptorExpansion(f);
      double continuation = 0.30 * persistence + 0.25 * stability +
                            0.18 * followNorm + 0.12 * breakNorm +
                            0.08 * alignment + 0.07 * localEdgeSupport;
      score = 0.76 * continuation +
              0.12 * Clamp01((expansion - 0.24) / 0.50) +
              0.12 * Clamp01((0.50 - noise) / 0.50);
      if(dir == DIR_SHORT) score += 0.08;
      if(stateId == STATE_KNOWN_2) score += 0.10;
      if(stateId == STATE_KNOWN_4) score -= 0.08;
      if(stateId == STATE_KNOWN_3 || stateId == STATE_TRANSITION || stateId == STATE_KNOWN_1) score -= 0.18;
      if(persistence < 0.62) score -= 0.18;
      if(stability < 0.46) score -= 0.16;
      if(noise > 0.46) score -= 0.14;
      if(localEdgeSupport < 0.16) score -= 0.08;
   }
   else if(algoId == CORE_EXHAUSTION_RESET)
   {
      // v2p63 pass 2: preserve the profitable late-directional/shock thesis and
      // explicitly remove the Transition pocket that damaged pass 1.
      double persistence = DescriptorPersistence(dir,f);
      double expansion = DescriptorExpansion(f);
      double noise = DescriptorNoise(f);
      double stability = DescriptorStability(f);
      double fadingDrive = 0.36 * Clamp01((0.48 - followNorm) / 0.48) +
                           0.24 * Clamp01((0.42 - breakNorm) / 0.42) +
                           0.16 * Clamp01((f.overlap - 0.18) / 0.48) +
                           0.14 * Clamp01((0.76 - persistence) / 0.76) +
                           0.10 * localEdgeSupport;
      double exhaustion = 0.42 * expansion + 0.22 * noise +
                          0.18 * (1.0 - stability) + 0.18 * Clamp01(g_changeScore);
      score = 0.56 * exhaustion + 0.34 * fadingDrive +
              0.10 * Clamp01((0.54 - localEdgePenalty) / 0.54);
      if(stateId == STATE_KNOWN_3) score += 0.12;
      if(stateId == STATE_KNOWN_4) score += 0.10;
      if(stateId == STATE_TRANSITION) score -= 0.22;
      if(stateId == STATE_KNOWN_1) score -= 0.10;
      if(persistence > 0.78) score -= 0.16;
      if(expansion < 0.58) score -= 0.14;
      if(localEdgeSupport < 0.12) score -= 0.06;
   }
   else if(algoId == CORE_LONG_STRUCTURE_CONTINUATION)
   {
      // v2p64 new probation candidate: enter only when long-directional structure
      // is persistent, stable and orderly rather than chasing a single breakout bar.
      double persistence = DescriptorPersistence(dir,f);
      double expansion = DescriptorExpansion(f);
      double noise = DescriptorNoise(f);
      double stability = DescriptorStability(f);
      double structuralDrive = 0.30 * persistence + 0.26 * stability +
                               0.18 * followNorm + 0.12 * alignment +
                               0.08 * breakNorm + 0.06 * localEdgeSupport;
      double orderlyMove = 0.36 * Clamp01((expansion - 0.28) / 0.56) +
                           0.26 * Clamp01((0.48 - noise) / 0.48) +
                           0.22 * Clamp01((f.overlap - 0.08) / 0.42) +
                           0.16 * Clamp01((0.30 - bodyImpulse) / 0.30 + 0.5);
      score = 0.68 * structuralDrive + 0.24 * orderlyMove +
              0.08 * Clamp01((0.50 - localEdgePenalty) / 0.50);
      if(dir == DIR_LONG) score += 0.08; else score -= 0.18;
      if(stateId == STATE_KNOWN_4) score += 0.12;
      if(stateId == STATE_KNOWN_2) score -= 0.14;
      if(stateId == STATE_TRANSITION || stateId == STATE_KNOWN_3 || stateId == STATE_KNOWN_1) score -= 0.18;
      if(persistence < 0.60) score -= 0.16;
      if(stability < 0.48) score -= 0.14;
      if(noise > 0.44) score -= 0.14;
      if(localEdgeSupport < 0.14) score -= 0.07;
   }
   double algoBias = AlgoBiasValue(algoId);
   double stateAlgoBias = StateAlgoBiasValue(stateId, algoId);
   score += 0.08 * algoBias + 0.20 * stateAlgoBias;
   if(stateAlgoBias < -0.10) score -= 0.08 * Clamp01((-stateAlgoBias - 0.10) / 0.40);
   score -= 0.14 * localEdgePenalty;

   // v2p54 behavior-specialized selection priors. State fit now matters more
   // than broad algorithm popularity, while all candidates remain candle-driven.
   if(algoId == CORE_DRIFT_CONTINUATION) score += 0.02;       // RangeReclaim
   if(algoId == CORE_COMPRESSION_RELEASE) score += 0.02;     // transition/release candidate
   if(algoId == CORE_PULLBACK) score -= 0.02;
   if(algoId == CORE_BREAKOUT) score -= 0.02;                // TrendRetest descriptor-led
   if(CoreAlgoIsSidelined(algoId))
      score *= 0.15;
   return Clamp01(score);
}

double DirectionalIntentScoreAtBar(int shift, int dir, int policyId, bool forProbe)
{
   if(Bars < DonchianPeriod + shift + FeatureWindowLong + 10) return 0.0;
   if(dir != DIR_LONG && dir != DIR_SHORT) return 0.0;
   if(!forProbe && !SpreadOK()) return 0.0;
   if(forProbe && UseSpreadGateOnProbeSignals && !SpreadOK()) return 0.0;

   double atr = GetATR(shift);
   if(atr <= 0.0) return 0.0;

   double h = iHigh(Symbol(), Period(), shift);
   double l = iLow(Symbol(), Period(), shift);
   double o = iOpen(Symbol(), Period(), shift);
   double c = iClose(Symbol(), Period(), shift);
   double range = h - l;
   if(range <= 0.0) range = atr;

   double breakoutUp = iHigh(Symbol(), Period(), iHighest(Symbol(), Period(), MODE_HIGH, DonchianPeriod, shift + 1));
   double breakoutDn = iLow(Symbol(), Period(), iLowest(Symbol(), Period(), MODE_LOW, DonchianPeriod, shift + 1));

   double breakoutStrength = 0.0;
   double bodyImpulse = 0.0;
   double closeLocationScore = 0.0;

   if(dir == DIR_LONG)
   {
      breakoutStrength = Clamp01((c - breakoutUp) / MathMax(atr, Point));
      bodyImpulse = Clamp01((c - o) / MathMax(atr, Point));
      closeLocationScore = Clamp01((c - l) / MathMax(range, Point));
   }
   else
   {
      breakoutStrength = Clamp01((breakoutDn - c) / MathMax(atr, Point));
      bodyImpulse = Clamp01((o - c) / MathMax(atr, Point));
      closeLocationScore = Clamp01((h - c) / MathMax(range, Point));
   }

   if(UseCloseLocationFilter)
   {
      if(dir == DIR_LONG && closeLocationScore < MinCloseLocationLong) return 0.0;
      if(dir == DIR_SHORT && closeLocationScore > MaxCloseLocationShort) return 0.0;
   }

   if(UseBreakoutDispFilter)
   {
      if(dir == DIR_LONG && breakoutStrength < MinBreakoutDispATRLong) return 0.0;
      if(dir == DIR_SHORT && breakoutStrength < MinBreakoutDispATRShort) return 0.0;
   }

   FeatureVector f = BuildFeatureVectorAtShift(shift);
   double followNorm = Clamp01(((dir == DIR_LONG ? f.followAsym : -f.followAsym) + 0.18) / 0.55);
   double breakNorm  = Clamp01(((dir == DIR_LONG ? f.breakAsym  : -f.breakAsym ) + 0.20) / 0.60);
   double pathNorm   = 0.55 * Clamp01((f.pathEff24 + 0.03) / 0.35) +
                       0.45 * Clamp01((f.pathEff72 + 0.03) / 0.28);

   double policyPref = Clamp01((PolicyDirectionalPreference(policyId, dir) + 1.0) / 2.0);
   double statePref = Clamp01((StateDirectionalPreference(g_currentState, dir) + 1.0) / 2.0);

   double alignment = 0.45 * breakoutStrength + 0.25 * bodyImpulse + 0.30 * followNorm;
   double structureQuality = 0.50 * breakNorm + 0.50 * pathNorm;
   double score = 0.0;
   score += IntentBreakoutWeight * (0.70 * breakoutStrength + 0.30 * breakNorm);
   score += IntentBodyWeight * bodyImpulse;
   score += IntentCloseLocationWeight * closeLocationScore;
   score += IntentFollowWeight * followNorm;
   score += IntentPathWeight * pathNorm;
   score += IntentStateWeight * statePref;
   score += IntentPolicyWeight * policyPref;

   score += PolicyIntentBias * (policyPref - 0.50);
   score += StateIntentBias * (statePref - 0.50);
   double stateBiasVal = StateBiasValue(g_currentState);
   double policyBiasVal = PolicyBiasValue(policyId);
   double stateDirBiasVal = StateDirBiasValue(g_currentState, dir);

   score += LocalBiasWeight_State * stateBiasVal;
   score += (LocalBiasWeight_Policy * 0.75) * policyBiasVal;
   score += (LocalBiasWeight_StateDir * 1.28) * stateDirBiasVal;
   score += 0.05 * OutcomeToBias(g_liveOutcomeEmaR);

   double localEdgeSupport = 0.45 * Clamp01((stateDirBiasVal + 0.10) / 0.35) +
                             0.30 * Clamp01((stateBiasVal + 0.10) / 0.35) +
                             0.25 * Clamp01((policyBiasVal + 0.10) / 0.35);
   double localEdgePenalty = 0.50 * Clamp01((-stateDirBiasVal - 0.02) / 0.20) +
                             0.30 * Clamp01((-stateBiasVal - 0.02) / 0.20) +
                             0.20 * Clamp01((-policyBiasVal - 0.02) / 0.20);
   double algoBreakout = CoreAlgoScore(CORE_BREAKOUT, g_currentState, dir, breakoutStrength, bodyImpulse, closeLocationScore,
                                      followNorm, breakNorm, pathNorm, alignment, structureQuality,
                                      localEdgeSupport, localEdgePenalty, stateDirBiasVal, f);
   double algoPullback = CoreAlgoScore(CORE_PULLBACK, g_currentState, dir, breakoutStrength, bodyImpulse, closeLocationScore,
                                      followNorm, breakNorm, pathNorm, alignment, structureQuality,
                                      localEdgeSupport, localEdgePenalty, stateDirBiasVal, f);
   double algoCompression = CoreAlgoScore(CORE_COMPRESSION_RELEASE, g_currentState, dir, breakoutStrength, bodyImpulse, closeLocationScore,
                                      followNorm, breakNorm, pathNorm, alignment, structureQuality,
                                      localEdgeSupport, localEdgePenalty, stateDirBiasVal, f);
   double algoShortHold = CoreAlgoScore(CORE_SHORT_HOLD, g_currentState, dir, breakoutStrength, bodyImpulse, closeLocationScore,
                                      followNorm, breakNorm, pathNorm, alignment, structureQuality,
                                      localEdgeSupport, localEdgePenalty, stateDirBiasVal, f);
   double algoDrift = CoreAlgoScore(CORE_DRIFT_CONTINUATION, g_currentState, dir, breakoutStrength, bodyImpulse, closeLocationScore,
                                      followNorm, breakNorm, pathNorm, alignment, structureQuality,
                                      localEdgeSupport, localEdgePenalty, stateDirBiasVal, f);
   double algoDelayed = CoreAlgoScore(CORE_DELAYED_CONFIRMATION, g_currentState, dir, breakoutStrength, bodyImpulse, closeLocationScore,
                                      followNorm, breakNorm, pathNorm, alignment, structureQuality,
                                      localEdgeSupport, localEdgePenalty, stateDirBiasVal, f);
   double algoMomentum = CoreAlgoScore(CORE_MOMENTUM_CONTINUATION, g_currentState, dir, breakoutStrength, bodyImpulse, closeLocationScore,
                                      followNorm, breakNorm, pathNorm, alignment, structureQuality,
                                      localEdgeSupport, localEdgePenalty, stateDirBiasVal, f);
   double algoExhaustion = CoreAlgoScore(CORE_EXHAUSTION_RESET, g_currentState, dir, breakoutStrength, bodyImpulse, closeLocationScore,
                                      followNorm, breakNorm, pathNorm, alignment, structureQuality,
                                      localEdgeSupport, localEdgePenalty, stateDirBiasVal, f);
   double algoLongStructure = CoreAlgoScore(CORE_LONG_STRUCTURE_CONTINUATION, g_currentState, dir, breakoutStrength, bodyImpulse, closeLocationScore,
                                      followNorm, breakNorm, pathNorm, alignment, structureQuality,
                                      localEdgeSupport, localEdgePenalty, stateDirBiasVal, f);

   // v2p56: continuous behavior-descriptor routing. State names are retained
   // for interpretation, but specialist eligibility is now earned primarily
   // from descriptor fit and confidence class.
   double routerConfidence = RouterBehaviorConfidence(g_currentState, dir, f);
   if(!forProbe && shift == 1)
   {
      // Evaluate every roster slot; the helper itself ignores non-sidelined algorithms.
      // This makes future status changes automatically participate in the relevance monitor.
      ConsiderSidelinedRelevanceCandidate(CORE_BREAKOUT, g_currentState, dir, algoBreakout, routerConfidence, f);
      ConsiderSidelinedRelevanceCandidate(CORE_PULLBACK, g_currentState, dir, algoPullback, routerConfidence, f);
      ConsiderSidelinedRelevanceCandidate(CORE_COMPRESSION_RELEASE, g_currentState, dir, algoCompression, routerConfidence, f);
      ConsiderSidelinedRelevanceCandidate(CORE_SHORT_HOLD, g_currentState, dir, algoShortHold, routerConfidence, f);
      ConsiderSidelinedRelevanceCandidate(CORE_DRIFT_CONTINUATION, g_currentState, dir, algoDrift, routerConfidence, f);
      ConsiderSidelinedRelevanceCandidate(CORE_DELAYED_CONFIRMATION, g_currentState, dir, algoDelayed, routerConfidence, f);
      ConsiderSidelinedRelevanceCandidate(CORE_MOMENTUM_CONTINUATION, g_currentState, dir, algoMomentum, routerConfidence, f);
      ConsiderSidelinedRelevanceCandidate(CORE_EXHAUSTION_RESET, g_currentState, dir, algoExhaustion, routerConfidence, f);
      ConsiderSidelinedRelevanceCandidate(CORE_LONG_STRUCTURE_CONTINUATION, g_currentState, dir, algoLongStructure, routerConfidence, f);
   }
   int chosenAlgo = -1;
   double chosenAlgoScore = -1.0;
   double secondAlgoScore = -1.0;
   string eligibleNames = "";

   ConsiderRouterCandidate(CORE_BREAKOUT, algoBreakout,
      RouterEligible(CORE_BREAKOUT, g_currentState, dir, routerConfidence, f),
      g_currentState, dir, f, routerConfidence, chosenAlgo, chosenAlgoScore, secondAlgoScore, eligibleNames);
   ConsiderRouterCandidate(CORE_PULLBACK, algoPullback,
      RouterEligible(CORE_PULLBACK, g_currentState, dir, routerConfidence, f),
      g_currentState, dir, f, routerConfidence, chosenAlgo, chosenAlgoScore, secondAlgoScore, eligibleNames);
   ConsiderRouterCandidate(CORE_COMPRESSION_RELEASE, algoCompression,
      RouterEligible(CORE_COMPRESSION_RELEASE, g_currentState, dir, routerConfidence, f),
      g_currentState, dir, f, routerConfidence, chosenAlgo, chosenAlgoScore, secondAlgoScore, eligibleNames);
   ConsiderRouterCandidate(CORE_SHORT_HOLD, algoShortHold,
      RouterEligible(CORE_SHORT_HOLD, g_currentState, dir, routerConfidence, f),
      g_currentState, dir, f, routerConfidence, chosenAlgo, chosenAlgoScore, secondAlgoScore, eligibleNames);
   ConsiderRouterCandidate(CORE_DRIFT_CONTINUATION, algoDrift,
      RouterEligible(CORE_DRIFT_CONTINUATION, g_currentState, dir, routerConfidence, f),
      g_currentState, dir, f, routerConfidence, chosenAlgo, chosenAlgoScore, secondAlgoScore, eligibleNames);
   ConsiderRouterCandidate(CORE_DELAYED_CONFIRMATION, algoDelayed,
      RouterEligible(CORE_DELAYED_CONFIRMATION, g_currentState, dir, routerConfidence, f),
      g_currentState, dir, f, routerConfidence, chosenAlgo, chosenAlgoScore, secondAlgoScore, eligibleNames);
   ConsiderRouterCandidate(CORE_MOMENTUM_CONTINUATION, algoMomentum,
      RouterEligible(CORE_MOMENTUM_CONTINUATION, g_currentState, dir, routerConfidence, f),
      g_currentState, dir, f, routerConfidence, chosenAlgo, chosenAlgoScore, secondAlgoScore, eligibleNames);
   ConsiderRouterCandidate(CORE_EXHAUSTION_RESET, algoExhaustion,
      RouterEligible(CORE_EXHAUSTION_RESET, g_currentState, dir, routerConfidence, f),
      g_currentState, dir, f, routerConfidence, chosenAlgo, chosenAlgoScore, secondAlgoScore, eligibleNames);
   ConsiderRouterCandidate(CORE_LONG_STRUCTURE_CONTINUATION, algoLongStructure,
      RouterEligible(CORE_LONG_STRUCTURE_CONTINUATION, g_currentState, dir, routerConfidence, f),
      g_currentState, dir, f, routerConfidence, chosenAlgo, chosenAlgoScore, secondAlgoScore, eligibleNames);

   // If a low-confidence state intentionally has no eligible specialist, keep a
   // diagnostic candidate but suppress the live thesis strongly. This avoids
   // silently reverting to the old "all algorithms compete everywhere" design.
   bool routerHasCandidate = (chosenAlgo >= 0);
   if(!routerHasCandidate)
   {
      chosenAlgo = -1;
      chosenAlgoScore = 0.0;
      secondAlgoScore = 0.0;
      eligibleNames = "NONE";
   }
   if(secondAlgoScore < 0.0) secondAlgoScore = 0.0;
   double selectionMargin = MathMax(0.0, chosenAlgoScore - secondAlgoScore);

   if(!forProbe && shift == 1)
   {
      if(dir == DIR_LONG)
      {
         g_lastCoreAlgoLong = chosenAlgo;
         g_lastCoreAlgoLongScore = chosenAlgoScore;
         g_lastRouterConfidenceLong = routerConfidence;
         g_lastRouterMarginLong = selectionMargin;
         g_lastRouterEligibleLong = eligibleNames;
      }
      else if(dir == DIR_SHORT)
      {
         g_lastCoreAlgoShort = chosenAlgo;
         g_lastCoreAlgoShortScore = chosenAlgoScore;
         g_lastRouterConfidenceShort = routerConfidence;
         g_lastRouterMarginShort = selectionMargin;
         g_lastRouterEligibleShort = eligibleNames;
      }
   }

   // v2p58 hard enforcement: no eligible live specialist means no live intent.
   // A sidelined algorithm can never act as a fallback attribution target.
   if(!routerHasCandidate && !forProbe) return 0.0;
   // A close algorithm race means the behavior description did not identify a
   // decisive specialist; reduce conviction rather than forcing certainty.
   if(routerHasCandidate && selectionMargin < 0.055 && routerConfidence < 0.50)
      score -= 0.09;
   if(routerConfidence < 0.32 && !forProbe)
      score -= 0.06;

   score += 0.08 * (localEdgeSupport - 0.50);
   if(localEdgePenalty > 0.12)
      score -= 0.16 * Clamp01((localEdgePenalty - 0.12) / 0.88);
   if(localEdgePenalty > 0.40 && !forProbe)
      score -= 0.06 * Clamp01((localEdgePenalty - 0.40) / 0.60);

   if(g_currentState == STATE_KNOWN_1)
   {
      double compressionPenalty = 0.18;
      if(alignment < 0.62) compressionPenalty += (0.62 - alignment) * 0.35;
      if(structureQuality < 0.55) compressionPenalty += (0.55 - structureQuality) * 0.20;
      score -= compressionPenalty;
      if(alignment > 0.78 && structureQuality > 0.62)
         score += 0.06;
   }
   else if(g_currentState == STATE_TRANSITION)
   {
      double signedBreak = (dir == DIR_LONG ? f.breakAsym : -f.breakAsym);
      double signedFollow = (dir == DIR_LONG ? f.followAsym : -f.followAsym);
      double directionalCoherence = 0.55 * Clamp01((signedBreak + 0.08) / 0.36) +
                                    0.45 * Clamp01((signedFollow + 0.06) / 0.24);
      double directionalDisagreement = AbsD(signedBreak - signedFollow);
      double transitionUsability = 0.34 * alignment +
                                   0.26 * structureQuality +
                                   0.24 * directionalCoherence +
                                   0.16 * Clamp01(0.50 + 0.5 * stateDirBiasVal);

      double transitionPenalty = 0.08;
      if(alignment < 0.64) transitionPenalty += (0.64 - alignment) * 0.20;
      if(structureQuality < 0.54) transitionPenalty += (0.54 - structureQuality) * 0.10;
      if(directionalCoherence < 0.54) transitionPenalty += (0.54 - directionalCoherence) * 0.10;
      transitionPenalty += 0.025 * Clamp01((0.12 - MathAbs(signedBreak)) / 0.12);
      transitionPenalty += 0.025 * Clamp01((0.09 - MathAbs(signedFollow)) / 0.09);
      transitionPenalty += 0.025 * Clamp01((directionalDisagreement - 0.20) / 0.26);
      transitionPenalty -= 0.09 * Clamp01((transitionUsability - 0.54) / 0.46);
      transitionPenalty -= 0.06 * Clamp01((localEdgeSupport - 0.50) / 0.50);
      transitionPenalty += 0.08 * Clamp01((localEdgePenalty - 0.16) / 0.84);
      score -= transitionPenalty;
      if(alignment > 0.74 && structureQuality > 0.58 && directionalCoherence > 0.54)
         score += 0.10;
      if(localEdgeSupport > 0.60 && directionalCoherence > 0.56)
         score += 0.05 * Clamp01((localEdgeSupport - 0.60) / 0.40);
   }
   else if(g_currentState == STATE_KNOWN_2 || g_currentState == STATE_KNOWN_4)
   {
      double directionalBoost = 0.0;
      if(alignment > 0.66) directionalBoost += 0.06;
      if(structureQuality > 0.56) directionalBoost += 0.05;
      if(breakoutStrength > 0.10) directionalBoost += 0.04;
      if(bodyImpulse > 0.24 && followNorm > 0.28) directionalBoost += 0.03;
      directionalBoost += 0.03 * Clamp01((stateDirBiasVal + 0.10) / 0.40);
      if(alignment > 0.78 && structureQuality > 0.62) directionalBoost += 0.03;
      if(bodyImpulse < 0.16 || followNorm < 0.20) directionalBoost -= 0.04;
      score += directionalBoost;
   }
   else if(g_currentState == STATE_KNOWN_3)
   {
      double signedBreak = (dir == DIR_LONG ? f.breakAsym : -f.breakAsym);
      double signedFollow = (dir == DIR_LONG ? f.followAsym : -f.followAsym);
      double continuationAgreement = 0.55 * Clamp01((signedBreak + 0.10) / 0.45) +
                                     0.45 * Clamp01((signedFollow + 0.08) / 0.35);
      double continuationQuality = 0.34 * breakoutStrength +
                                   0.20 * bodyImpulse +
                                   0.20 * followNorm +
                                   0.16 * pathNorm +
                                   0.10 * continuationAgreement;
      double exhaustionRisk = Clamp01((0.58 - bodyImpulse) / 0.58) * 0.30 +
                              Clamp01((0.58 - followNorm) / 0.58) * 0.28 +
                              Clamp01((0.50 - pathNorm) / 0.50) * 0.18 +
                              Clamp01((f.overlap - 0.38) / 0.32) * 0.14 +
                              Clamp01((0.06 - signedFollow) / 0.18) * 0.10;
      double chaosRisk = Clamp01((f.overlap - 0.32) / 0.36) * 0.40 +
                         Clamp01((0.52 - pathNorm) / 0.52) * 0.30 +
                         Clamp01((0.10 - MathAbs(signedBreak)) / 0.10) * 0.15 +
                         Clamp01((0.08 - MathAbs(signedFollow)) / 0.08) * 0.15;

      score -= 0.08;
      score += 0.12 * (continuationQuality - 0.52);
      score += 0.08 * (continuationAgreement - 0.50);
      score -= 0.16 * exhaustionRisk;
      score -= 0.20 * chaosRisk;

      if(continuationQuality > 0.74 && continuationAgreement > 0.66 && chaosRisk < 0.30)
         score += 0.06;
   }
   else if(g_currentState == STATE_KNOWN_0)
   {
      double signedBreak = (dir == DIR_LONG ? f.breakAsym : -f.breakAsym);
      double signedFollow = (dir == DIR_LONG ? f.followAsym : -f.followAsym);
      double directionalCoherence = 0.55 * Clamp01((signedBreak + 0.06) / 0.34) +
                                    0.45 * Clamp01((signedFollow + 0.05) / 0.22);
      double directionalDisagreement = AbsD(signedBreak - signedFollow);

      score -= 0.03;
      score -= 0.06 * Clamp01((0.52 - directionalCoherence) / 0.52);
      score -= 0.04 * Clamp01((directionalDisagreement - 0.16) / 0.22);
      score -= 0.06 * Clamp01((localEdgePenalty - 0.18) / 0.82);
      if(alignment > 0.68 && structureQuality > 0.55 && directionalCoherence > 0.56)
         score += 0.08;
      if(localEdgeSupport > 0.58 && directionalCoherence > 0.58)
         score += 0.05 * Clamp01((localEdgeSupport - 0.58) / 0.42);
   }
   else if(g_currentState == STATE_UNKNOWN)
   {
      score -= 0.04;
   }

   double metaQuality = MetaEntryQualityFromSignals(f, dir, g_currentState, policyId,
                                                    breakoutStrength, bodyImpulse, closeLocationScore,
                                                    followNorm, breakNorm, pathNorm);
   double tradeQualityScore = EvaluateTradeQualityScore(g_currentState, policyId, dir,
                                                        localEdgeSupport, localEdgePenalty,
                                                        metaQuality, alignment, structureQuality);
   score += 0.18 * (metaQuality - 0.50);
   score += 0.12 * (tradeQualityScore - 0.50);

   double minMetaQuality = 0.36 + 0.07 * g_changeScore;
   if(g_currentState == STATE_TRANSITION) minMetaQuality += -0.01 - 0.07 * TransitionTradability();
   if(g_currentState == STATE_KNOWN_1) minMetaQuality += 0.02;
   if(g_currentState == STATE_KNOWN_0 || g_currentState == STATE_TRANSITION)
   {
      minMetaQuality -= 0.05 * Clamp01((localEdgeSupport - 0.56) / 0.44);
      minMetaQuality += 0.05 * Clamp01((localEdgePenalty - 0.18) / 0.82);
   }
   if(g_currentState == STATE_KNOWN_2 || g_currentState == STATE_KNOWN_4)
   {
      double directionalRelief = 0.04 * Clamp01((stateDirBiasVal + 0.08) / 0.38) +
                                 0.03 * Clamp01((g_structureStability - 0.28) / 0.40);
      minMetaQuality -= directionalRelief;
      minMetaQuality += 0.03 * Clamp01((0.05 - stateDirBiasVal) / 0.20);
   }
   if(g_currentState == STATE_KNOWN_0)
      minMetaQuality -= 0.03 * Clamp01((stateDirBiasVal + 0.05) / 0.30);
   minMetaQuality += 0.03 * Clamp01((0.48 - localEdgeSupport) / 0.48);
   minMetaQuality = MathMax(0.28, minMetaQuality);

   double minTradeQuality = 0.48 + 0.05 * g_changeScore;
   if(g_currentState == STATE_TRANSITION)
      minTradeQuality += -0.02 - 0.05 * TransitionTradability();
   if(g_currentState == STATE_KNOWN_2 || g_currentState == STATE_KNOWN_4)
      minTradeQuality -= 0.03 * Clamp01((stateDirBiasVal + 0.08) / 0.38);
   if(g_currentState == STATE_KNOWN_0)
      minTradeQuality -= 0.02 * Clamp01((localEdgeSupport - 0.55) / 0.45);
   minTradeQuality += 0.04 * Clamp01((localEdgePenalty - 0.18) / 0.82);
   minTradeQuality = MathMax(0.36, minTradeQuality);

   if(!forProbe && tradeQualityScore < minTradeQuality)
      score -= 0.18 * Clamp01((minTradeQuality - tradeQualityScore) / MathMax(minTradeQuality, 0.05));
   else if(tradeQualityScore > 0.62)
      score += 0.04 * Clamp01((tradeQualityScore - 0.62) / 0.38);

   if(!forProbe && metaQuality < minMetaQuality)
      score -= 0.16 * Clamp01((minMetaQuality - metaQuality) / MathMax(minMetaQuality, 0.05));
   else if(metaQuality > 0.66)
      score += 0.05 * Clamp01((metaQuality - 0.66) / 0.34);

   if(!forProbe && shift == 1)
   {
      if(dir == DIR_LONG)
      {
         g_metaQualityLong = metaQuality;
         g_tradeQualityLong = tradeQualityScore;
      }
      else if(dir == DIR_SHORT)
      {
         g_metaQualityShort = metaQuality;
         g_tradeQualityShort = tradeQualityScore;
      }
   }

   score += 0.10 * (chosenAlgoScore - 0.50);
   if(chosenAlgo == CORE_BREAKOUT && breakoutStrength > 0.12 && followNorm > 0.24)
      score += 0.03;
   else if(chosenAlgo == CORE_PULLBACK && pathNorm > 0.46 && breakoutStrength < 0.10)
      score += 0.03;
   else if(chosenAlgo == CORE_COMPRESSION_RELEASE && g_currentState == STATE_KNOWN_1)
      score += 0.04;
   else if(chosenAlgo == CORE_SHORT_HOLD && g_currentState == STATE_TRANSITION)
      score += 0.03;
   else if(chosenAlgo == CORE_DRIFT_CONTINUATION && (g_currentState == STATE_KNOWN_2 || g_currentState == STATE_KNOWN_4))
      score += 0.035;
   else if(chosenAlgo == CORE_MOMENTUM_CONTINUATION && DescriptorPersistence(dir,f) > 0.62)
      score += 0.04;
   else if(chosenAlgo == CORE_EXHAUSTION_RESET && DescriptorExpansion(f) > 0.62 && g_changeScore > 0.30)
      score += 0.035;
   else if(chosenAlgo == CORE_LONG_STRUCTURE_CONTINUATION && dir == DIR_LONG && DescriptorPersistence(dir,f) > 0.62 && DescriptorStability(f) > 0.50)
      score += 0.04;

   if(!forProbe)
   {
      double rc = RiskComfort01();
      score += 0.04 * (rc - 0.50);

      if(g_currentState == STATE_UNKNOWN)
         score -= (1.0 - rc) * 0.08;
      else if(g_currentState == STATE_TRANSITION)
         score -= (1.0 - rc) * (0.04 - 0.03 * TransitionTradability());
      else if(g_lastDecision.confidence < 0.45)
         score -= (1.0 - rc) * 0.06;

      if(UseStateGateOnSignalQuality)
      {
         if(g_currentState == STATE_UNKNOWN && !AllowLiveTradingInUnknown) score -= 0.18;
         if(g_currentState == STATE_TRANSITION && !AllowLiveTradingInTransition) score -= 0.08 - 0.05 * TransitionTradability();
      }
      if(InTransitionBuffer() && g_currentState != STATE_UNKNOWN && g_currentState != STATE_TRANSITION)
         score -= 0.12;
   }

   return Clamp01(score);
}

int DecideIntentDirectionAtBar(int shift, int policyId, bool forProbe, double &longScore, double &shortScore)
{
   longScore = DirectionalIntentScoreAtBar(shift, DIR_LONG, policyId, forProbe);
   shortScore = DirectionalIntentScoreAtBar(shift, DIR_SHORT, policyId, forProbe);

   double minScore = (forProbe ? ProbeIntentThreshold() : LiveIntentThreshold());

   if(longScore < minScore && shortScore < minScore)
      return DIR_NONE;

   if(longScore >= minScore && longScore >= shortScore + IntentDominanceThreshold())
      return DIR_LONG;

   if(shortScore >= minScore && shortScore >= longScore + IntentDominanceThreshold())
      return DIR_SHORT;

   return DIR_NONE;
}

void AddVirtualTrade(int policyId, int dir)
{
   if(!UseVirtualProbeLayer) return;
   if(policyId == POLICY_NOTRADE || policyId == POLICY_COMPRESSION_NOTRADE) return;

   int freeIndex = -1;
   for(int i=0; i<ArraySize(g_virtualTrades); i++)
   {
      if(!g_virtualTrades[i].active)
      {
         freeIndex = i;
         break;
      }
   }
   if(freeIndex < 0) return;

   double atr = GetATR(1);
   if(atr <= 0.0) return;

   double entry = iClose(Symbol(), Period(), 1);
   if(entry <= 0.0) entry = (dir == DIR_LONG ? Ask : Bid);
   double risk = StopATR * atr;
   double reward = TargetATR * atr;

   g_virtualTrades[freeIndex].active = true;
   g_virtualTrades[freeIndex].ticketId = g_virtualNextId++;
   g_virtualTrades[freeIndex].policyId = policyId;
   g_virtualTrades[freeIndex].dir = dir;
   g_virtualTrades[freeIndex].entryTime = TimeCurrent();
   g_virtualTrades[freeIndex].entryPrice = entry;
   g_virtualTrades[freeIndex].atrAtEntry = atr;
   g_virtualTrades[freeIndex].barsHeld = 0;
   g_virtualTrades[freeIndex].outcomeR = 0.0;

   if(dir == DIR_LONG)
   {
      g_virtualTrades[freeIndex].stopPrice = entry - risk;
      g_virtualTrades[freeIndex].targetPrice = entry + reward;
   }
   else
   {
      g_virtualTrades[freeIndex].stopPrice = entry + risk;
      g_virtualTrades[freeIndex].targetPrice = entry - reward;
   }
}

void UpdateVirtualTrades()
{
   for(int i=0; i<ArraySize(g_virtualTrades); i++)
   {
      if(!g_virtualTrades[i].active) continue;

      g_virtualTrades[i].barsHeld++;

      double h = iHigh(Symbol(), Period(), 0);
      double l = iLow(Symbol(), Period(), 0);
      bool closeNow = false;
      double exitPrice = 0.0;

      if(g_virtualTrades[i].dir == DIR_LONG)
      {
         if(l <= g_virtualTrades[i].stopPrice)
         {
            closeNow = true;
            exitPrice = g_virtualTrades[i].stopPrice;
         }
         else if(h >= g_virtualTrades[i].targetPrice)
         {
            closeNow = true;
            exitPrice = g_virtualTrades[i].targetPrice;
         }
      }
      else
      {
         if(h >= g_virtualTrades[i].stopPrice)
         {
            closeNow = true;
            exitPrice = g_virtualTrades[i].stopPrice;
         }
         else if(l <= g_virtualTrades[i].targetPrice)
         {
            closeNow = true;
            exitPrice = g_virtualTrades[i].targetPrice;
         }
      }

      if(!closeNow && g_virtualTrades[i].barsHeld >= MaxHoldBars)
      {
         closeNow = true;
         exitPrice = iClose(Symbol(), Period(), 0);
      }

      if(closeNow)
      {
         double risk = StopATR * g_virtualTrades[i].atrAtEntry;
         double pnl = 0.0;
         if(g_virtualTrades[i].dir == DIR_LONG)
            pnl = exitPrice - g_virtualTrades[i].entryPrice;
         else
            pnl = g_virtualTrades[i].entryPrice - exitPrice;

         double outcomeR = 0.0;
         if(risk > 0.0) outcomeR = pnl / risk;

         PushClosedVirtual(g_virtualTrades[i].policyId, outcomeR);
         g_virtualTrades[i].active = false;
      }
   }
}

bool HaveOpenLivePosition()
{
   for(int i=OrdersTotal()-1; i>=0; i--)
   {
      if(!OrderSelect(i, SELECT_BY_POS, MODE_TRADES)) continue;
      if(OrderSymbol() != Symbol()) continue;
      if(OrderMagicNumber() != MagicNumber) continue;
      if(OrderType() == OP_BUY || OrderType() == OP_SELL) return true;
   }
   return false;
}

bool OpenLiveTrade(int dir, int stateId, int policyId)
{
   if(HaveOpenLivePosition()) return false;
   if(!SpreadOK()) return false;

   double atr = GetATR(1);
   if(atr <= 0.0) return false;

   double lots = NormalizeLotsToBroker(FixedLot * RiskLotMultiplier());
   double stopAtrMult = EffectiveStopATR(stateId, policyId, dir);
   double targetAtrMult = EffectiveTargetATR(stateId, policyId, dir);
   double risk = stopAtrMult * atr;
   double reward = targetAtrMult * atr;

   int coreAlgo = (dir == DIR_LONG ? g_lastCoreAlgoLong : g_lastCoreAlgoShort);
   if(coreAlgo == CORE_PULLBACK)
      reward *= 1.06;
   else if(coreAlgo == CORE_COMPRESSION_RELEASE)
      reward *= 0.90;
   else if(coreAlgo == CORE_SHORT_HOLD)
      reward *= 0.82;
   else if(coreAlgo == CORE_DRIFT_CONTINUATION)
      reward *= 0.98;
   else if(coreAlgo == CORE_DELAYED_CONFIRMATION)
      reward *= 1.04;
   else if(coreAlgo == CORE_MOMENTUM_CONTINUATION)
      reward *= 1.08;
   else if(coreAlgo == CORE_EXHAUSTION_RESET)
      reward *= 0.94;
   else if(coreAlgo == CORE_LONG_STRUCTURE_CONTINUATION)
      reward *= 1.08;

   RefreshRates();

   int ticket = -1;
   if(dir == DIR_LONG)
   {
      double price = NormalizePrice(Ask);
      double sl = NormalizePrice(price - risk);
      double tp = NormalizePrice(price + reward);
      ticket = OrderSend(Symbol(), OP_BUY, lots, price, SlippagePoints, sl, tp, RunTag, MagicNumber, 0, clrBlue);
   }
   else if(dir == DIR_SHORT)
   {
      double price = NormalizePrice(Bid);
      double sl = NormalizePrice(price + risk);
      double tp = NormalizePrice(price - reward);
      ticket = OrderSend(Symbol(), OP_SELL, lots, price, SlippagePoints, sl, tp, RunTag, MagicNumber, 0, clrRed);
   }

   if(ticket <= 0)
   {
      int err = GetLastError();
      Print("OrderSend failed dir=", dir,
            " lots=", DoubleToString(lots, 2),
            " spreadPts=", DoubleToString(CurrentSpreadPoints(), 1),
            " err=", err);
      return false;
   }
   RegisterLiveContext(ticket, stateId, policyId, dir, coreAlgo, risk);
   return true;
}

void ManageLiveTrades()
{
   for(int i=OrdersTotal()-1; i>=0; i--)
   {
      if(!OrderSelect(i, SELECT_BY_POS, MODE_TRADES)) continue;
      if(OrderSymbol() != Symbol()) continue;
      if(OrderMagicNumber() != MagicNumber) continue;

      int type = OrderType();
      if(type != OP_BUY && type != OP_SELL) continue;

      datetime openTime = OrderOpenTime();
      int barsHeld = 0;
      for(int s=0; s<Bars; s++)
      {
         if(iTime(Symbol(), Period(), s) <= openTime)
         {
            barsHeld = s;
            break;
         }
      }

      double atr = GetATR(1);
      if(atr <= 0.0) continue;

      int ctxIndex = FindLiveContextIndex(OrderTicket());
      int ctxState = g_currentState;
      int ctxPolicy = POLICY_BALANCED;
      int ctxDir = (type == OP_BUY ? DIR_LONG : DIR_SHORT);
      if(ctxIndex >= 0)
      {
         ctxState = g_liveCtx[ctxIndex].stateId;
         ctxPolicy = g_liveCtx[ctxIndex].policyId;
         ctxDir = g_liveCtx[ctxIndex].dir;
      }

      int maxHoldBarsEff = EffectiveMaxHoldBars(ctxState, ctxPolicy, ctxDir);
      double trailAtrEff = EffectiveTrailATR(ctxState, ctxPolicy, ctxDir);

      if(barsHeld >= maxHoldBarsEff)
      {
         if(type == OP_BUY)
         {
            bool closeOk = OrderClose(OrderTicket(), OrderLots(), Bid, SlippagePoints, clrGray);
            if(!closeOk)
               Print("OrderClose failed ticket=", OrderTicket(), " err=", GetLastError());
         }
         else
         {
            bool closeOk = OrderClose(OrderTicket(), OrderLots(), Ask, SlippagePoints, clrGray);
            if(!closeOk)
               Print("OrderClose failed ticket=", OrderTicket(), " err=", GetLastError());
         }
         continue;
      }

      if(barsHeld >= TrailStartBars)
      {
         if(type == OP_BUY)
         {
            double newSL = NormalizePrice(Bid - trailAtrEff * atr);
            if(newSL > OrderStopLoss())
            {
               bool modifiedBuy = OrderModify(OrderTicket(), OrderOpenPrice(), newSL, OrderTakeProfit(), 0, clrBlue);
               if(!modifiedBuy)
                  Print("OrderModify failed ticket=", OrderTicket(), " err=", GetLastError());
            }
         }
         else if(type == OP_SELL)
         {
            double newSL2 = NormalizePrice(Ask + trailAtrEff * atr);
            if(OrderStopLoss() == 0.0 || newSL2 < OrderStopLoss())
            {
               bool modifiedSell = OrderModify(OrderTicket(), OrderOpenPrice(), newSL2, OrderTakeProfit(), 0, clrRed);
               if(!modifiedSell)
                  Print("OrderModify failed ticket=", OrderTicket(), " err=", GetLastError());
            }
         }
      }
   }
}

int StateSlot(int stateId)
{
   if(stateId == STATE_KNOWN_0) return 0;
   if(stateId == STATE_KNOWN_1) return 1;
   if(stateId == STATE_KNOWN_2) return 2;
   if(stateId == STATE_KNOWN_3) return 3;
   if(stateId == STATE_KNOWN_4) return 4;
   return -1;
}

int DirSlot(int dir)
{
   if(dir == DIR_LONG) return 0;
   if(dir == DIR_SHORT) return 1;
   return -1;
}

double ClampSigned(double v, double lim)
{
   if(v > lim) return lim;
   if(v < -lim) return -lim;
   return v;
}

double OutcomeToBias(double emaR)
{
   return ClampSigned(emaR / 1.5, 0.35);
}

double StateBiasValue(int stateId)
{
   int s = StateSlot(stateId);
   if(s < 0) return 0.0;
   return OutcomeToBias(g_stateOutcomeEma[s]);
}

double PolicyBiasValue(int policyId)
{
   if(policyId < 0 || policyId > 4) return 0.0;
   return OutcomeToBias(g_policyOutcomeEma[policyId]);
}

double StateDirBiasValue(int stateId, int dir)
{
   int s = StateSlot(stateId);
   int d = DirSlot(dir);
   if(s < 0 || d < 0) return 0.0;
   return OutcomeToBias(g_stateDirOutcomeEma[s][d]);
}

double AlgoBiasValue(int algoId)
{
   if(algoId < 0 || algoId >= 5) return 0.0;
   return OutcomeToBias(g_algoOutcomeEma[algoId]);
}

double StateAlgoBiasValue(int stateId, int algoId)
{
   int s = StateSlot(stateId);
   if(s < 0 || algoId < 0 || algoId >= 5) return 0.0;
   return OutcomeToBias(g_stateAlgoOutcomeEma[s][algoId]);
}

int FindLiveContextIndex(int ticket)
{
   if(ticket <= 0) return -1;
   for(int i=0;i<ArraySize(g_liveCtx);i++)
   {
      if(g_liveCtx[i].ticket == ticket) return i;
   }
   return -1;
}

void RegisterLiveContext(int ticket, int stateId, int policyId, int dir, int coreAlgo, double riskPrice)
{
   if(ticket <= 0) return;
   for(int i=0;i<ArraySize(g_liveCtx);i++)
   {
      if(g_liveCtx[i].ticket == ticket || g_liveCtx[i].ticket == 0)
      {
         g_liveCtx[i].ticket = ticket;
         g_liveCtx[i].stateId = stateId;
         g_liveCtx[i].policyId = policyId;
         g_liveCtx[i].dir = dir;
         g_liveCtx[i].coreAlgo = coreAlgo;
         g_liveCtx[i].riskPrice = riskPrice;
         return;
      }
   }
}

bool PopLiveContext(int ticket, int &stateId, int &policyId, int &dir, int &coreAlgo, double &riskPrice)
{
   for(int i=0;i<ArraySize(g_liveCtx);i++)
   {
      if(g_liveCtx[i].ticket != ticket) continue;
      stateId = g_liveCtx[i].stateId;
      policyId = g_liveCtx[i].policyId;
      dir = g_liveCtx[i].dir;
      coreAlgo = g_liveCtx[i].coreAlgo;
      riskPrice = g_liveCtx[i].riskPrice;
      g_liveCtx[i].ticket = 0;
      g_liveCtx[i].stateId = STATE_UNKNOWN;
      g_liveCtx[i].policyId = POLICY_NOTRADE;
      g_liveCtx[i].dir = DIR_NONE;
      g_liveCtx[i].coreAlgo = CORE_BREAKOUT;
      g_liveCtx[i].riskPrice = 0.0;
      return true;
   }
   return false;
}

void ApplyOutcomeToLiveBiases(int stateId, int policyId, int dir, int coreAlgo, double outcomeR)
{
   double a = LiveOutcomeEmaAlpha;
   if(a < 0.01) a = 0.01;
   if(a > 1.0) a = 1.0;

   g_liveOutcomeEmaR = (1.0 - a) * g_liveOutcomeEmaR + a * outcomeR;
   if(outcomeR > 0.0)
   {
      g_liveWinStreak++;
      g_liveLossStreak = 0;
   }
   else if(outcomeR < 0.0)
   {
      g_liveLossStreak++;
      g_liveWinStreak = 0;
   }

   int s = StateSlot(stateId);
   if(s >= 0)
      g_stateOutcomeEma[s] = (1.0 - a) * g_stateOutcomeEma[s] + a * outcomeR;

   if(policyId >= 0 && policyId <= 4)
      g_policyOutcomeEma[policyId] = (1.0 - a) * g_policyOutcomeEma[policyId] + a * outcomeR;

   int d = DirSlot(dir);
   if(s >= 0 && d >= 0)
      g_stateDirOutcomeEma[s][d] = (1.0 - a) * g_stateDirOutcomeEma[s][d] + a * outcomeR;

   if(coreAlgo >= 0 && coreAlgo < NUM_CORE_ALGOS)
      g_algoOutcomeEma[coreAlgo] = (1.0 - a) * g_algoOutcomeEma[coreAlgo] + a * outcomeR;

   if(s >= 0 && coreAlgo >= 0 && coreAlgo < NUM_CORE_ALGOS)
      g_stateAlgoOutcomeEma[s][coreAlgo] = (1.0 - a) * g_stateAlgoOutcomeEma[s][coreAlgo] + a * outcomeR;
}

void UpdateLiveOutcomeAdaptation()
{
   int hist = OrdersHistoryTotal();
   if(hist <= 0)
   {
      g_lastHistoryTotal = 0;
      return;
   }

   if(g_lastHistoryTotal > hist) g_lastHistoryTotal = 0;

   for(int i = hist - 1; i >= g_lastHistoryTotal; i--)
   {
      if(!OrderSelect(i, SELECT_BY_POS, MODE_HISTORY)) continue;
      if(OrderSymbol() != Symbol()) continue;
      if(OrderMagicNumber() != MagicNumber) continue;
      int type = OrderType();
      if(type != OP_BUY && type != OP_SELL) continue;

      int stateId = STATE_UNKNOWN;
      int policyId = POLICY_NOTRADE;
      int dir = (type == OP_BUY ? DIR_LONG : DIR_SHORT);
      int coreAlgo = CORE_BREAKOUT;
      double riskPrice = 0.0;
      PopLiveContext(OrderTicket(), stateId, policyId, dir, coreAlgo, riskPrice);

      double pnl = OrderProfit() + OrderSwap() + OrderCommission();
      double pipValue = MarketInfo(Symbol(), MODE_TICKVALUE);
      double pipSize = PipSize();
      double riskMoney = 0.0;
      if(riskPrice > 0.0 && pipValue > 0.0 && OrderLots() > 0.0)
      {
         double riskPips = riskPrice / pipSize;
         riskMoney = riskPips * pipValue * OrderLots();
      }
      if(riskMoney <= 0.0)
      {
         double approxRiskPips = StopATR * (GetATR(1) / pipSize);
         riskMoney = approxRiskPips * pipValue * MathMax(OrderLots(), 0.01);
      }
      if(riskMoney <= 0.0) riskMoney = 1.0;
      double outcomeR = pnl / riskMoney;
      ApplyOutcomeToLiveBiases(stateId, policyId, dir, coreAlgo, outcomeR);
      UpdateAlgoAttribution(coreAlgo, pnl, OrderCloseTime());
      AppendTradeLog(OrderCloseTime(), coreAlgo, stateId, policyId, dir, pnl, outcomeR);
   }
   g_lastHistoryTotal = hist;
}

