void ComputeFeatureContext(int startShift, int samples, FeatureVector &meanF, FeatureVector &stdF)
{
   meanF.atrPips = 0.0; meanF.atrRatio = 0.0; meanF.overlap = 0.0;
   meanF.pathEff24 = 0.0; meanF.pathEff72 = 0.0; meanF.breakAsym = 0.0; meanF.followAsym = 0.0;
   stdF = meanF;

   int n = 0;
   for(int s = startShift; s < startShift + samples; s++)
   {
      if(Bars <= s + FeatureWindowLong + DonchianPeriod + 5) break;
      FeatureVector x = BuildFeatureVectorAtShift(s);
      meanF.atrPips    += x.atrPips;
      meanF.atrRatio   += x.atrRatio;
      meanF.overlap    += x.overlap;
      meanF.pathEff24  += x.pathEff24;
      meanF.pathEff72  += x.pathEff72;
      meanF.breakAsym  += x.breakAsym;
      meanF.followAsym += x.followAsym;
      n++;
   }

   if(n <= 0)
   {
      meanF = BuildFeatureVectorAtShift(startShift);
      stdF.atrPips = MathMax(meanF.atrPips * 0.10, 1.0);
      stdF.atrRatio = 0.10;
      stdF.overlap = 0.05;
      stdF.pathEff24 = 0.10;
      stdF.pathEff72 = 0.08;
      stdF.breakAsym = 0.35;
      stdF.followAsym = 0.15;
      return;
   }

   meanF.atrPips    /= n;
   meanF.atrRatio   /= n;
   meanF.overlap    /= n;
   meanF.pathEff24  /= n;
   meanF.pathEff72  /= n;
   meanF.breakAsym  /= n;
   meanF.followAsym /= n;

   for(int s2 = startShift; s2 < startShift + n; s2++)
   {
      FeatureVector x2 = BuildFeatureVectorAtShift(s2);
      stdF.atrPips    += MathPow(x2.atrPips    - meanF.atrPips, 2);
      stdF.atrRatio   += MathPow(x2.atrRatio   - meanF.atrRatio, 2);
      stdF.overlap    += MathPow(x2.overlap    - meanF.overlap, 2);
      stdF.pathEff24  += MathPow(x2.pathEff24  - meanF.pathEff24, 2);
      stdF.pathEff72  += MathPow(x2.pathEff72  - meanF.pathEff72, 2);
      stdF.breakAsym  += MathPow(x2.breakAsym  - meanF.breakAsym, 2);
      stdF.followAsym += MathPow(x2.followAsym - meanF.followAsym, 2);
   }

   stdF.atrPips    = MathSqrt(stdF.atrPips / n);    if(stdF.atrPips < 1.0) stdF.atrPips = 1.0;
   stdF.atrRatio   = MathSqrt(stdF.atrRatio / n);   if(stdF.atrRatio < 0.05) stdF.atrRatio = 0.05;
   stdF.overlap    = MathSqrt(stdF.overlap / n);    if(stdF.overlap < 0.02) stdF.overlap = 0.02;
   stdF.pathEff24  = MathSqrt(stdF.pathEff24 / n);  if(stdF.pathEff24 < 0.04) stdF.pathEff24 = 0.04;
   stdF.pathEff72  = MathSqrt(stdF.pathEff72 / n);  if(stdF.pathEff72 < 0.03) stdF.pathEff72 = 0.03;
   stdF.breakAsym  = MathSqrt(stdF.breakAsym / n);  if(stdF.breakAsym < 0.20) stdF.breakAsym = 0.20;
   stdF.followAsym = MathSqrt(stdF.followAsym / n); if(stdF.followAsym < 0.08) stdF.followAsym = 0.08;
}

double RecentStateChangePressure(FeatureVector &f)
{
   FeatureVector prev = BuildFeatureVectorAtShift(2);
   double dAtr    = AbsD(f.atrRatio - prev.atrRatio);
   double dOver   = AbsD(f.overlap - prev.overlap);
   double dP24    = AbsD(f.pathEff24 - prev.pathEff24);
   double dBrk    = AbsD(f.breakAsym - prev.breakAsym);
   double dFollow = AbsD(f.followAsym - prev.followAsym);

   double pressure = 0.0;
   pressure += 0.25 * Clamp01(dAtr / 0.15);
   pressure += 0.20 * Clamp01(dOver / 0.06);
   pressure += 0.20 * Clamp01(dP24 / 0.12);
   pressure += 0.20 * Clamp01(dBrk / 0.80);
   pressure += 0.15 * Clamp01(dFollow / 0.20);
   return Clamp01(pressure);
}


double FeatureDeltaZ(double a, double b, double scale)
{
   double denom = MathMax(scale, 0.0001);
   return AbsD(a - b) / denom;
}

double ComputeAdaptiveChangeScore(FeatureVector &f)
{
   FeatureVector shortMean, shortStd, longMean, longStd;
   int shortSamples = MathMax(10, FeatureWindowShort / 2);
   int longSamples  = MathMax(24, StateLookbackBars);
   ComputeFeatureContext(2, shortSamples, shortMean, shortStd);
   ComputeFeatureContext(2 + shortSamples, longSamples, longMean, longStd);

   double dAtrRatio = FeatureDeltaZ(shortMean.atrRatio, longMean.atrRatio, longStd.atrRatio);
   double dOverlap  = FeatureDeltaZ(shortMean.overlap,  longMean.overlap,  longStd.overlap);
   double dP24      = FeatureDeltaZ(shortMean.pathEff24,longMean.pathEff24,longStd.pathEff24);
   double dP72      = FeatureDeltaZ(shortMean.pathEff72,longMean.pathEff72,longStd.pathEff72);
   double dBreak    = FeatureDeltaZ(shortMean.breakAsym,longMean.breakAsym,MathMax(longStd.breakAsym,0.20));
   double dFollow   = FeatureDeltaZ(shortMean.followAsym,longMean.followAsym,MathMax(longStd.followAsym,0.08));
   double dLive     = 0.30 * FeatureDeltaZ(f.atrRatio, longMean.atrRatio, longStd.atrRatio) +
                      0.20 * FeatureDeltaZ(f.overlap,  longMean.overlap,  longStd.overlap) +
                      0.20 * FeatureDeltaZ(f.pathEff24,longMean.pathEff24,longStd.pathEff24) +
                      0.15 * FeatureDeltaZ(f.breakAsym,longMean.breakAsym,MathMax(longStd.breakAsym,0.20)) +
                      0.15 * FeatureDeltaZ(f.followAsym,longMean.followAsym,MathMax(longStd.followAsym,0.08));

   double score = 0.20 * Clamp01(dAtrRatio / 1.6) +
                  0.16 * Clamp01(dOverlap  / 1.6) +
                  0.18 * Clamp01(dP24      / 1.6) +
                  0.12 * Clamp01(dP72      / 1.6) +
                  0.16 * Clamp01(dBreak    / 1.8) +
                  0.10 * Clamp01(dFollow   / 1.8) +
                  0.08 * Clamp01(dLive     / 1.8);
   return Clamp01(score);
}

double ComputeStructureStability(StateDecision &d)
{
   double stable = 0.58 * d.confidence + 0.24 * (1.0 - g_changeScore);
   if(g_currentState == STATE_TRANSITION) stable -= 0.05;
   if(g_currentState == STATE_UNKNOWN) stable -= 0.08;
   if(g_liveLossStreak >= 2) stable -= 0.025 * MathMin(g_liveLossStreak - 1, 3);
   stable += 0.03 * MathMin(g_liveWinStreak, 3);
   return Clamp01(stable);
}

double MetaEntryQualityFromSignals(FeatureVector &f, int dir, int stateId, int policyId,
                                   double breakoutStrength, double bodyImpulse, double closeLocationScore,
                                   double followNorm, double breakNorm, double pathNorm)
{
   double signedBreak = (dir == DIR_LONG ? f.breakAsym : -f.breakAsym);
   double signedFollow = (dir == DIR_LONG ? f.followAsym : -f.followAsym);

   double directionalCoherence = 0.45 * Clamp01((signedBreak + 0.08) / 0.38) +
                                 0.35 * Clamp01((signedFollow + 0.06) / 0.26) +
                                 0.20 * pathNorm;
   double disagreement = AbsD(signedBreak - signedFollow);
   double opportunity = 0.28 * breakoutStrength +
                        0.22 * bodyImpulse +
                        0.18 * closeLocationScore +
                        0.16 * followNorm +
                        0.16 * pathNorm;

   double quality = 0.34 * directionalCoherence +
                    0.28 * opportunity +
                    0.18 * g_structureStability +
                    0.08 * Clamp01((PolicyDirectionalPreference(policyId, dir) + 1.0) / 2.0) +
                    0.06 * Clamp01((StateDirectionalPreference(stateId, dir) + 1.0) / 2.0) +
                    0.06 * Clamp01(0.50 + 0.5 * StateDirBiasValue(stateId, dir));

   quality -= 0.10 * g_changeScore;
   quality -= 0.10 * Clamp01((disagreement - 0.20) / 0.28);

   if(stateId == STATE_KNOWN_1)
   {
      quality -= 0.14 * Clamp01((0.62 - breakoutStrength) / 0.62);
      quality -= 0.10 * Clamp01((0.58 - followNorm) / 0.58);
   }
   else if(stateId == STATE_TRANSITION)
   {
      quality -= 0.10 * Clamp01((0.56 - directionalCoherence) / 0.56);
      quality -= 0.05 * Clamp01((0.52 - pathNorm) / 0.52);
   }
   else if(stateId == STATE_KNOWN_3)
   {
      double chaosRisk = 0.45 * Clamp01((f.overlap - 0.34) / 0.34) +
                         0.35 * Clamp01((0.52 - pathNorm) / 0.52) +
                         0.20 * Clamp01((0.10 - MathAbs(signedFollow)) / 0.10);
      quality -= 0.18 * chaosRisk;
   }

   return Clamp01(quality);
}

StateDecision ClassifyState(FeatureVector &f)
{
   StateDecision d;
   d.stateId = STATE_UNKNOWN;
   d.bestStateId = STATE_UNKNOWN;
   d.bestScore = 0.0;
   d.secondScore = 0.0;
   d.confidence = 0.0;
   d.isUnknown = true;
   d.isTransition = false;

   FeatureVector meanF, stdF;
   ComputeFeatureContext(2, StateLookbackBars, meanF, stdF);

   double zAtrPips  = ZScore(f.atrPips, meanF.atrPips, stdF.atrPips);
   double zAtrRatio = ZScore(f.atrRatio, meanF.atrRatio, stdF.atrRatio);
   double zOverlap  = ZScore(f.overlap, meanF.overlap, stdF.overlap);
   double zP24      = ZScore(f.pathEff24, meanF.pathEff24, stdF.pathEff24);
   double zP72      = ZScore(f.pathEff72, meanF.pathEff72, stdF.pathEff72);

   double breakNorm  = SafeDiv(f.breakAsym, MathMax(stdF.breakAsym, 0.35), 0.0);
   double followNorm = SafeDiv(f.followAsym, MathMax(stdF.followAsym, 0.12), 0.0);

   double dirBias = (0.58 * followNorm) + (0.42 * breakNorm);
   double dirStrength = (0.55 * Clamp01(AbsD(followNorm) / 1.6)) +
                        (0.30 * Clamp01(AbsD(breakNorm) / 1.6)) +
                        (0.15 * Clamp01((0.60 * zP24 + 0.40 * zP72 + 0.30) / 1.30));

   double flowExpansion = (0.42 * Clamp01((0.60 * zP24 + 0.40 * zP72 + 0.40) / 1.40)) +
                          (0.28 * Clamp01((zAtrRatio + 0.20) / 1.20)) +
                          (0.15 * Clamp01((zAtrPips + 0.20) / 1.40)) +
                          (0.15 * Clamp01((-zOverlap + 0.20) / 1.20));

   double scoreCompression = 0.28 * Clamp01((-zAtrPips + 0.20) / 1.20) +
                             0.22 * Clamp01((-zAtrRatio + 0.10) / 1.00) +
                             0.22 * Clamp01((zOverlap + 0.10) / 1.00) +
                             0.18 * Clamp01((-(0.65 * zP24 + 0.35 * zP72) + 0.10) / 1.00) +
                             0.10 * Clamp01((0.90 - dirStrength) / 0.90);

   double scoreShock = 0.30 * Clamp01((zAtrRatio + 0.35) / 1.20) +
                       0.20 * Clamp01((zAtrPips + 0.25) / 1.50) +
                       0.15 * Clamp01((-zOverlap + 0.20) / 1.20) +
                       0.15 * Clamp01((AbsD(breakNorm) - 0.30) / 1.20) +
                       0.10 * Clamp01((AbsD(followNorm) - 0.20) / 1.00) +
                       0.10 * Clamp01((0.50 * zP24 + 0.50 * zP72 + 0.20) / 1.20);

   double scoreBalanced = 0.45 * flowExpansion +
                          0.30 * ScoreCentral(dirBias, 0.0, 0.90) +
                          0.15 * Clamp01((zAtrRatio + 0.10) / 1.00) +
                          0.10 * Clamp01((0.75 - scoreCompression) / 0.75);

   double scoreLong = 0.36 * Clamp01((dirBias - BehaviorDirectionalThreshold) / 1.10) +
                      0.26 * flowExpansion +
                      0.20 * dirStrength +
                      0.10 * Clamp01((-zOverlap + 0.15) / 1.10) +
                      0.08 * Clamp01((0.85 - scoreCompression) / 0.85);

   double scoreShort = 0.36 * Clamp01(((-dirBias) - BehaviorDirectionalThreshold) / 1.10) +
                       0.26 * flowExpansion +
                       0.20 * dirStrength +
                       0.10 * Clamp01((-zOverlap + 0.15) / 1.10) +
                       0.08 * Clamp01((0.85 - scoreCompression) / 0.85);

   g_lastLongStateScore = scoreLong;
   g_lastShortStateScore = scoreShort;

   double scores[NUM_CORE_ALGOS];
   int ids[NUM_CORE_ALGOS];
   scores[0] = scoreBalanced;    ids[0] = STATE_KNOWN_0;
   scores[1] = scoreCompression; ids[1] = STATE_KNOWN_1;
   scores[2] = scoreShort;       ids[2] = STATE_KNOWN_2;
   scores[3] = scoreShock;       ids[3] = STATE_KNOWN_3;
   scores[4] = scoreLong;        ids[4] = STATE_KNOWN_4;

   double best = -1.0;
   double second = -1.0;
   int bestId = STATE_UNKNOWN;

   for(int i = 0; i < 5; i++)
   {
      if(scores[i] > best)
      {
         second = best;
         best = scores[i];
         bestId = ids[i];
      }
      else if(scores[i] > second)
      {
         second = scores[i];
      }
   }

   if(second < 0.0) second = 0.0;
   double regimeShiftPressure = RecentStateChangePressure(f);
   double conflict = Clamp01((second - (best - TransitionConfidenceGap)) / MathMax(TransitionConfidenceGap, 0.05));
   double coherence = Clamp01(best - (0.45 * second));
   double confidence = Clamp01((0.70 * coherence) + (0.30 * best) - (0.20 * regimeShiftPressure));

   d.bestStateId = bestId;
   d.bestScore = best;
   d.secondScore = second;
   d.confidence = confidence;

   bool strongCompression = (scoreCompression >= BehaviorCompressionThreshold);
   bool strongShock = (scoreShock >= BehaviorShockThreshold);
   bool strongDirectional = (MathMax(scoreLong, scoreShort) >= MinKnownStateConfidence);
   bool strongBalanced = (scoreBalanced >= BehaviorBalancedThreshold);

   if(!(strongCompression || strongShock || strongDirectional || strongBalanced))
   {
      d.stateId = STATE_UNKNOWN;
      d.isUnknown = true;
      d.isTransition = false;
      return d;
   }

   if(best < MinKnownStateConfidence)
   {
      d.stateId = STATE_UNKNOWN;
      d.isUnknown = true;
      d.isTransition = false;
      return d;
   }

   bool highShift = (regimeShiftPressure > 0.76);
   bool strongConflict = (conflict > 0.58);
   bool weakCoherence = (coherence < 0.52);
   bool directionalAmbiguity = (bestId == STATE_KNOWN_0 || bestId == STATE_KNOWN_3);

   if(g_currentState != STATE_UNKNOWN)
   {
      bool severeInstability = ((highShift && strongConflict && weakCoherence) ||
                                (strongConflict && coherence < 0.46) ||
                                (highShift && directionalAmbiguity && coherence < 0.44));
      bool unstableButTradable = (highShift && !strongConflict && coherence >= 0.56 && MathMax(scoreLong, scoreShort) >= (MinKnownStateConfidence + 0.03));
      if(severeInstability && !unstableButTradable)
      {
         d.stateId = STATE_TRANSITION;
         d.isUnknown = false;
         d.isTransition = true;
         return d;
      }
   }

   d.stateId = bestId;
   d.isUnknown = false;
   d.isTransition = false;
   return d;
}

void UpdateStateMachine(StateDecision &d)
{
   int proposed = d.stateId;

   if(g_currentState == STATE_UNKNOWN)
   {
      g_prevState = g_currentState;
      g_currentState = proposed;
      g_stateBarsHeld = 0;
      g_barsSinceStateChange = 0;
      return;
   }

   bool canSwitch = (g_stateBarsHeld >= MinStateHoldBars);

   if(proposed != g_currentState && canSwitch)
   {
      g_prevState = g_currentState;
      g_currentState = proposed;
      g_stateBarsHeld = 0;
      g_barsSinceStateChange = 0;
   }
   else
   {
      g_stateBarsHeld++;
      if(g_barsSinceStateChange < 999999) g_barsSinceStateChange++;
   }
}

bool InTransitionBuffer()
{
   if(!UseTransitionBuffer) return false;
   if(g_currentState == STATE_TRANSITION) return true;
   if(g_barsSinceStateChange <= TransitionBufferBars) return true;
   return false;
}

double TransitionTradability()
{
   double coherence = Clamp01(g_lastFeatures.pathEff24 * 0.40 + g_lastFeatures.pathEff72 * 0.25 + g_lastFeatures.followAsym * 0.20 + (1.0 - g_lastFeatures.overlap) * 0.15);
   double directional = MathMax(g_lastLongStateScore, g_lastShortStateScore);
   double lowConflict = 1.0 - MathAbs(g_lastLongStateScore - g_lastShortStateScore);
   lowConflict = 1.0 - lowConflict;
   double tradable = 0.45 * coherence + 0.30 * Clamp01((directional - 0.48) / 0.40) + 0.20 * Clamp01((g_structureStability - 0.28) / 0.42) + 0.05 * Clamp01((0.70 - g_changeScore) / 0.40);
   tradable += 0.08 * Clamp01((0.55 - g_lastFeatures.overlap) / 0.30);
   tradable += 0.06 * Clamp01((MathAbs(g_lastFeatures.breakAsym) - 0.12) / 0.35);
   tradable -= 0.08 * Clamp01((0.10 - lowConflict) / 0.10);
   return Clamp01(tradable);
}


int SelectPolicyForState()
{
   double bestScore = -1e9;
   int bestPolicy = POLICY_NOTRADE;

   for(int p=0; p<=4; p++)
   {
      bool enabled = false;
      if(p == POLICY_NOTRADE && EnablePolicy_NoTrade) enabled = true;
      if(p == POLICY_BALANCED && EnablePolicy_BalancedBreakout) enabled = true;
      if(p == POLICY_LONG_BIAS && EnablePolicy_LongBiasBreakout) enabled = true;
      if(p == POLICY_SHORT_BIAS && EnablePolicy_ShortBiasBreakout) enabled = true;
      if(p == POLICY_COMPRESSION_NOTRADE && EnablePolicy_CompressionNoTrade) enabled = true;
      if(!enabled) continue;

      double s = PolicyScore(p);
      s += LocalBiasWeight_State * StateBiasValue(g_currentState);
      s += LocalBiasWeight_Policy * PolicyBiasValue(p);
      if(g_currentState == STATE_KNOWN_2) s += 0.10 * StateDirBiasValue(g_currentState, DIR_SHORT);
      if(g_currentState == STATE_KNOWN_4) s += 0.10 * StateDirBiasValue(g_currentState, DIR_LONG);
      if(g_currentState == STATE_KNOWN_0)
         s += 0.02 * (StateDirBiasValue(g_currentState, DIR_LONG) + StateDirBiasValue(g_currentState, DIR_SHORT));

      if(p == POLICY_BALANCED) s += 0.03 * g_changeScore;
      if(p == POLICY_NOTRADE || p == POLICY_COMPRESSION_NOTRADE) s += 0.04 * g_changeScore;
      if((p == POLICY_LONG_BIAS || p == POLICY_SHORT_BIAS) && g_changeScore > 0.45)
         s -= 0.10 * (g_changeScore - 0.45) / 0.55;
      s += 0.05 * (g_structureStability - 0.50);

      if(p != POLICY_NOTRADE && p != POLICY_COMPRESSION_NOTRADE)
         s += DiscoveryBiasActivePolicies;

      if(p == POLICY_NOTRADE)
         s -= NoTradeBasePenalty;

      if(g_currentState == STATE_UNKNOWN)
      {
         if(p != POLICY_NOTRADE && p != POLICY_COMPRESSION_NOTRADE)
            s -= UnknownStateActivePenalty;
      }

      if(g_currentState == STATE_TRANSITION)
      {
         double tradable = TransitionTradability();
         if(p == POLICY_BALANCED) s += 0.05 - 0.05 * tradable;
         if(p == POLICY_NOTRADE || p == POLICY_COMPRESSION_NOTRADE) s += 0.07 - 0.04 * tradable;
         if(p == POLICY_LONG_BIAS || p == POLICY_SHORT_BIAS) s -= 0.08 - 0.16 * tradable;
         if(p != POLICY_NOTRADE && p != POLICY_COMPRESSION_NOTRADE)
            s -= TransitionStateActivePenalty * (1.0 - 0.80 * tradable);
      }

      if(g_currentState == STATE_KNOWN_1)
      {
         if(p == POLICY_COMPRESSION_NOTRADE) s += 0.38;
         if(p == POLICY_BALANCED) s -= 0.04;
         if(p == POLICY_LONG_BIAS || p == POLICY_SHORT_BIAS) s -= 0.22;
      }

      if(g_currentState == STATE_KNOWN_2 && p == POLICY_SHORT_BIAS)
         s += 0.34;

      if(g_currentState == STATE_KNOWN_4 && p == POLICY_LONG_BIAS)
         s += 0.34;

      if(g_currentState == STATE_KNOWN_3)
      {
         if(p == POLICY_BALANCED) s += 0.28;
         if(p == POLICY_NOTRADE || p == POLICY_COMPRESSION_NOTRADE) s += 0.04;
         if(p == POLICY_LONG_BIAS || p == POLICY_SHORT_BIAS) s -= 0.10;
      }

      if(g_currentState == STATE_KNOWN_0)
      {
         if(p == POLICY_BALANCED) s += 0.14;
         if(p == POLICY_LONG_BIAS || p == POLICY_SHORT_BIAS) s += 0.02;
      }

      if(s > bestScore)
      {
         bestScore = s;
         bestPolicy = p;
      }
   }

   if(bestScore < LivePolicyScoreThreshold())
      return POLICY_NOTRADE;

   return bestPolicy;
}

double PolicyScore(int policyId)
{
   int count = 0;
   double sum = 0.0;
   for(int i = g_closedVirtualCount - 1; i >= 0 && count < PolicyScoreLookbackClosed; i--)
   {
      if(g_closedVirtual[i].policyId != policyId) continue;
      sum += g_closedVirtual[i].outcomeR;
      count++;
   }

   if(count > 0)
      return sum / count;

   if(!UseBootstrapPolicyPriors)
   {
      if(policyId == POLICY_NOTRADE) return 0.20;
      return 0.0;
   }

   if(policyId == POLICY_NOTRADE) return 0.03;
   if(policyId == POLICY_BALANCED) return BootstrapScore_Balanced;
   if(policyId == POLICY_LONG_BIAS) return BootstrapScore_LongBias;
   if(policyId == POLICY_SHORT_BIAS) return BootstrapScore_ShortBias;
   if(policyId == POLICY_COMPRESSION_NOTRADE) return BootstrapScore_Compression;
   return 0.0;
}

void PushClosedVirtual(int policyId, double outcomeR)
{
   if(g_closedVirtualCount < ArraySize(g_closedVirtual))
   {
      g_closedVirtual[g_closedVirtualCount].policyId = policyId;
      g_closedVirtual[g_closedVirtualCount].outcomeR = outcomeR;
      g_closedVirtual[g_closedVirtualCount].closeTime = TimeCurrent();
      g_closedVirtualCount++;
      return;
   }
   for(int i=1; i<ArraySize(g_closedVirtual); i++)
      g_closedVirtual[i-1] = g_closedVirtual[i];
   g_closedVirtual[ArraySize(g_closedVirtual)-1].policyId = policyId;
   g_closedVirtual[ArraySize(g_closedVirtual)-1].outcomeR = outcomeR;
   g_closedVirtual[ArraySize(g_closedVirtual)-1].closeTime = TimeCurrent();
}

