//------------------------------
// Utility
//------------------------------
string BoolStr(bool v) { return v ? "1" : "0"; }

double AbsD(double v) { if(v < 0.0) return -v; return v; }

double Clamp01(double v)
{
   if(v < 0.0) return 0.0;
   if(v > 1.0) return 1.0;
   return v;
}

double SafeDiv(double num, double den, double fallback)
{
   if(den == 0.0) return fallback;
   return num / den;
}

double PipSize()
{
   if(Digits == 3 || Digits == 5) return (Point * 10.0);
   return Point;
}

int RiskComfortClamped()
{
   if(RiskComfort < 1) return 1;
   if(RiskComfort > 5) return 5;
   return RiskComfort;
}

double RiskComfort01()
{
   // Map simple user-facing scale 1..5 into internal 0..1 comfort.
   return (RiskComfortClamped() - 1.0) / 4.0;
}

double LivePolicyScoreThreshold()
{
   double rc = RiskComfort01();
   return BaseMinLivePolicyScore + (0.50 - rc) * 0.24;
}

double ProbeIntentThreshold()
{
   double rc = RiskComfort01();
   double th = BaseMinProbeIntentScore + (0.50 - rc) * 0.08;
   th += StreakTightenPerLoss * MathMin(g_liveLossStreak, 3);
   th -= StreakLoosenPerWin * MathMin(g_liveWinStreak, 2);
   if(th < 0.03) th = 0.03;
   return th;
}

double LiveIntentThreshold()
{
   double rc = RiskComfort01();
   double th = BaseMinLiveIntentScore + (0.50 - rc) * 0.14;
   th += StreakTightenPerLoss * MathMin(g_liveLossStreak, 3);
   th -= StreakLoosenPerWin * MathMin(g_liveWinStreak, 2);
   th -= 0.03 * OutcomeToBias(g_liveOutcomeEmaR);
   if(th < 0.05) th = 0.05;
   return th;
}

double IntentDominanceThreshold()
{
   double rc = RiskComfort01();
   double th = BaseMinIntentDominance + (0.50 - rc) * 0.04;
   th += 0.010 * MathMin(g_liveLossStreak, 3);
   th -= 0.006 * MathMin(g_liveWinStreak, 2);
   if(th < 0.005) th = 0.005;
   return th;
}

double RiskLotMultiplier()
{
   double rc = RiskComfort01();
   double mult = 0.50 + rc;
   mult *= (1.0 - LossLotPenaltyPerLoss * MathMin(g_liveLossStreak, 3));
   mult *= (1.0 + WinLotBoostPerWin * MathMin(g_liveWinStreak, 2));
   if(mult < 0.30) mult = 0.30;
   if(mult > 1.80) mult = 1.80;
   return mult;
}

double CurrentTradeStyleBias(int stateId, int policyId, int dir)
{
   double bias = 0.22 * OutcomeToBias(g_liveOutcomeEmaR);
   bias += 0.30 * StateBiasValue(stateId);
   bias += 0.22 * PolicyBiasValue(policyId);
   bias += 0.34 * StateDirBiasValue(stateId, dir);

   if(stateId == STATE_TRANSITION) bias -= 0.10;
   if(stateId == STATE_UNKNOWN) bias -= 0.12;
   if(stateId == STATE_KNOWN_1) bias -= 0.06; // LowVolCompression wants smaller expectations.
   if(stateId == STATE_KNOWN_3) bias -= 0.05; // ShockExpansion often needs caution.
   if(stateId == STATE_KNOWN_0) bias -= 0.03; // BalancedExpansion should not overreach.
   if(stateId == STATE_KNOWN_2 || stateId == STATE_KNOWN_4) bias += 0.04; // Directional states can earn more room.

   if(bias < -1.0) bias = -1.0;
   if(bias > 1.0) bias = 1.0;
   return bias;
}

double EvaluateTradeQualityScore(int stateId, int policyId, int dir, double localEdgeSupport, double localEdgePenalty, double metaQuality, double alignment, double structureQuality)
{
   double stateDirBiasVal = StateDirBiasValue(stateId, dir);
   double support = 0.30 * localEdgeSupport +
                    0.28 * metaQuality +
                    0.18 * structureQuality +
                    0.12 * alignment +
                    0.12 * Clamp01(0.50 + 0.5 * stateDirBiasVal);

   double risk = 0.34 * localEdgePenalty +
                 0.22 * g_changeScore +
                 0.18 * Clamp01((0.52 - metaQuality) / 0.52) +
                 0.14 * Clamp01((0.48 - structureQuality) / 0.48) +
                 0.12 * Clamp01((0.50 - alignment) / 0.50);

   if(stateId == STATE_TRANSITION)
      risk += 0.06 * Clamp01((0.55 - TransitionTradability()) / 0.55);
   if(stateId == STATE_UNKNOWN)
      risk += 0.08;
   if(stateId == STATE_KNOWN_1)
      risk += 0.04 * Clamp01((0.62 - alignment) / 0.62);

   return Clamp01(0.50 + (support - risk));
}

double EffectiveStopATR(int stateId, int policyId, int dir)
{
   double style = CurrentTradeStyleBias(stateId, policyId, dir);
   double mult = StopATR;
   if(style < 0.0) mult *= (1.0 + 0.10 * (-style));
   else            mult *= (1.0 + 0.06 * style);
   if(mult < StopATR * 0.90) mult = StopATR * 0.90;
   if(mult > StopATR * 1.20) mult = StopATR * 1.20;
   return mult;
}

double EffectiveTargetATR(int stateId, int policyId, int dir)
{
   double style = CurrentTradeStyleBias(stateId, policyId, dir);
   double mult = TargetATR;
   if(style < 0.0) mult *= (1.0 - 0.32 * (-style));
   else            mult *= (1.0 + 0.25 * style);
   if(stateId == STATE_KNOWN_1 || stateId == STATE_TRANSITION) mult *= 0.92;
   if(mult < TargetATR * 0.65) mult = TargetATR * 0.65;
   if(mult > TargetATR * 1.35) mult = TargetATR * 1.35;
   return mult;
}

double EffectiveTrailATR(int stateId, int policyId, int dir)
{
   double style = CurrentTradeStyleBias(stateId, policyId, dir);
   double mult = TrailATR;
   if(style < 0.0) mult *= (1.0 - 0.12 * (-style));
   else            mult *= (1.0 + 0.08 * style);
   if(mult < TrailATR * 0.80) mult = TrailATR * 0.80;
   if(mult > TrailATR * 1.20) mult = TrailATR * 1.20;
   return mult;
}

int EffectiveMaxHoldBars(int stateId, int policyId, int dir)
{
   double style = CurrentTradeStyleBias(stateId, policyId, dir);
   int bars = MaxHoldBars;
   if(style < 0.0) bars -= (int)MathRound(4.0 * (-style));
   else            bars += (int)MathRound(3.0 * style);
   if(stateId == STATE_KNOWN_1 || stateId == STATE_TRANSITION) bars -= 1;
   if(stateId == STATE_KNOWN_2 || stateId == STATE_KNOWN_4) bars += 1;
   if(bars < 6) bars = 6;
   if(bars > MaxHoldBars + 4) bars = MaxHoldBars + 4;
   return bars;
}

double ZScore(double value, double mean, double stdDev)
{
   double s = stdDev;
   if(s < 1e-8) s = 1e-8;
   return (value - mean) / s;
}

double ScoreCentral(double value, double center, double tolerance)
{
   double t = tolerance;
   if(t <= 0.0) t = 1.0;
   double dist = AbsD(value - center);
   return Clamp01(1.0 - (dist / t));
}

double NormalizePrice(double price)
{
   return NormalizeDouble(price, Digits);
}

double CurrentSpreadPoints()
{
   return (Ask - Bid) / Point;
}

double NormalizeLotsToBroker(double lots)
{
   double minLot = MarketInfo(Symbol(), MODE_MINLOT);
   double maxLot = MarketInfo(Symbol(), MODE_MAXLOT);
   double step = MarketInfo(Symbol(), MODE_LOTSTEP);

   if(step <= 0.0) step = 0.01;
   if(lots < minLot) lots = minLot;
   if(lots > maxLot) lots = maxLot;

   double stepped = MathFloor((lots / step) + 1e-8) * step;
   if(stepped < minLot) stepped = minLot;
   if(stepped > maxLot) stepped = maxLot;

   int lotDigits = 2;
   if(step < 0.1) lotDigits = 2;
   if(step < 0.01) lotDigits = 3;
   return NormalizeDouble(stepped, lotDigits);
}

bool IsNewBar()
{
   datetime t = iTime(Symbol(), Period(), 0);
   if(t == 0) return false;
   if(t != g_lastBarTime)
   {
      g_lastBarTime = t;
      return true;
   }
