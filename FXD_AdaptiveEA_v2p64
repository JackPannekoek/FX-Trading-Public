double GetATR(int shift)
{
   return iATR(Symbol(), Period(), ATRPeriod, shift);
}

double CloseLocation(int shift)
{
   double h = iHigh(Symbol(), Period(), shift);
   double l = iLow(Symbol(), Period(), shift);
   double c = iClose(Symbol(), Period(), shift);
   if(h <= l) return 0.5;
   return (c - l) / (h - l);
}

double AverageRangePips(int startShift, int bars)
{
   double sum = 0.0;
   int n = 0;
   for(int s = startShift; s < startShift + bars; s++)
   {
      double h = iHigh(Symbol(), Period(), s);
      double l = iLow(Symbol(), Period(), s);
      if(h == 0 && l == 0) continue;
      sum += (h - l) / PipSize();
      n++;
   }
   if(n <= 0) return 0.0;
   return sum / n;
}

double AverageATRRatio(int startShift, int bars)
{
   double sumATR = 0.0;
   double sumATRMA = 0.0;
   int n = 0;
   for(int s = startShift; s < startShift + bars; s++)
   {
      double atr = GetATR(s);
      if(atr <= 0.0) continue;
      sumATR += atr;
      n++;
   }
   if(n <= 0) return 1.0;
   double meanATR = sumATR / n;

   int look = 50;
   double sum = 0.0;
   int n2 = 0;
   for(int s2 = startShift; s2 < startShift + bars + look; s2++)
   {
      double atr2 = GetATR(s2);
      if(atr2 <= 0.0) continue;
      sum += atr2;
      n2++;
   }
   if(n2 <= 0) return 1.0;
   double longMean = sum / n2;
   if(longMean <= 0.0) return 1.0;
   return meanATR / longMean;
}

double AverageOverlap(int startShift, int bars)
{
   double sum = 0.0;
   int n = 0;
   for(int s = startShift; s < startShift + bars - 1; s++)
   {
      double h1 = iHigh(Symbol(), Period(), s);
      double l1 = iLow(Symbol(), Period(), s);
      double h2 = iHigh(Symbol(), Period(), s + 1);
      double l2 = iLow(Symbol(), Period(), s + 1);
      double overlapHigh = MathMin(h1, h2);
      double overlapLow = MathMax(l1, l2);
      double overlap = overlapHigh - overlapLow;
      double range1 = h1 - l1;
      if(range1 <= 0.0) continue;
      if(overlap < 0.0) overlap = 0.0;
      sum += overlap / range1;
      n++;
   }
   if(n <= 0) return 0.0;
   return sum / n;
}

double PathEfficiency(int startShift, int bars)
{
   if(bars < 2) return 0.0;
   double cNow = iClose(Symbol(), Period(), startShift);
   double cPast = iClose(Symbol(), Period(), startShift + bars - 1);
   double net = AbsD(cNow - cPast);
   double path = 0.0;
   for(int s = startShift; s < startShift + bars - 1; s++)
   {
      double c1 = iClose(Symbol(), Period(), s);
      double c2 = iClose(Symbol(), Period(), s + 1);
      path += AbsD(c1 - c2);
   }
   if(path <= 0.0) return 0.0;
   return net / path;
}

double BreakoutAsymmetry(int startShift, int bars)
{
   int upCount = 0;
   int dnCount = 0;
   for(int s = startShift; s < startShift + bars; s++)
   {
      double atr = GetATR(s);
      if(atr <= 0.0) continue;
      double c = iClose(Symbol(), Period(), s);
      double breakoutUp = iHigh(Symbol(), Period(), iHighest(Symbol(), Period(), MODE_HIGH, DonchianPeriod, s + 1));
      double breakoutDn = iLow(Symbol(), Period(), iLowest(Symbol(), Period(), MODE_LOW, DonchianPeriod, s + 1));
      double up = (c - breakoutUp) / atr;
      double dn = (breakoutDn - c) / atr;
      if(up > 0.0) upCount++;
      if(dn > 0.0) dnCount++;
   }
   int total = upCount + dnCount;
   if(total <= 0) return 0.0;
   return double(upCount - dnCount) / double(total);
}

double FollowThroughAsymmetry(int startShift, int bars)
{
   double upSum = 0.0;
   double dnSum = 0.0;
   int upN = 0;
   int dnN = 0;

   for(int s = startShift + 1; s < startShift + bars; s++)
   {
      double atr = GetATR(s);
      if(atr <= 0.0) continue;

      double c = iClose(Symbol(), Period(), s);
      double cPrev = iClose(Symbol(), Period(), s + 1);

      if(c > cPrev)
      {
         upSum += (c - cPrev) / atr;
         upN++;
      }
      else if(c < cPrev)
      {
         dnSum += (cPrev - c) / atr;
         dnN++;
      }
   }

   double upAvg = (upN > 0 ? upSum / upN : 0.0);
   double dnAvg = (dnN > 0 ? dnSum / dnN : 0.0);
   return upAvg - dnAvg;
}


FeatureVector BuildFeatureVectorAtShift(int shift)
{
   FeatureVector f;
   f.atrPips    = AverageRangePips(shift, FeatureWindowShort);
   f.atrRatio   = AverageATRRatio(shift, FeatureWindowShort);
   f.overlap    = AverageOverlap(shift, FeatureWindowShort);
   f.pathEff24  = PathEfficiency(shift, FeatureWindowShort);
   f.pathEff72  = PathEfficiency(shift, FeatureWindowLong);
   f.breakAsym  = BreakoutAsymmetry(shift, FeatureWindowShort);
   f.followAsym = FollowThroughAsymmetry(shift, FeatureWindowShort);
   return f;
}

FeatureVector BuildFeatureVector()
{
   return BuildFeatureVectorAtShift(1);
}

